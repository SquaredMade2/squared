{
  "name": "squared",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run --filter='./packages/**/*' build",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "dev": "turbo run dev --filter=web --filter=api",
    "types:check": "turbo run types:check",
    "clean": "turbo run clean",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "reset": "turbo run reset && pnpm install",
    "start": "turbo run start",
    "storybook": "pnpm run --filter=@repo/ui storybook",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=web",
    "test:api": "turbo run test --filter=api"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.2",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@biomejs/biome": "1.8.3",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@radix-ui/react-dialog": "^1.1.1",
    "husky": "^9.0.11",
    "turbo": "^2.0.10"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=7.0.0"
  },
  "packageManager": "pnpm@9.7.0",
  "dependencies": {
    "rimraf": "^6.0.1"
  }
}
