{
  "name": "squared",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "api:gen": "pnpm run --filter=api2 gen",
    "build": "turbo run build",
    "db:gen": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "docker:build": "docker-compose build",
    "docker:db": "pnpm --filter=test-db run docker:db && pnpm run db:gen && pnpm run db:push",
    "docker:db:down": "pnpm --filter=test-db run docker:db:down",
    "docker:db:seed": "pnpm --filter=test-db run db:seed",
    "docker:up": "docker-compose up",
    "dev": "turbo run dev --filter=web --filter=api2",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "cypress:ci": "start-server-and-test storybook http://localhost:9009 cypress:run",
    "cypress:dev": "cypress open",
    "cypress:run": "cypress run",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "reset": "turbo run reset && pnpm install",
    "start": "turbo run start",
    "storybook": "pnpm run --filter=@repo/ui storybook",
    "studio": "turbo run studio",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=web",
    "test:api": "turbo run test --filter=api",
    "test:ci": "turbo run test:ci"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.0.11",
    "rimraf": "^6.0.1",
    "turbo": "^2.0.10"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=7.0.0"
  },
  "packageManager": "pnpm@9.7.0",
  "dependencies": {}
}
