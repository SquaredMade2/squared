{
  "name": "squared",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "api:gen": "pnpm run --filter=api2 gen",
    "build": "turbo run build",
    "db:gen": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "docker:build": "docker-compose build",
    "docker:db": "pnpm --filter=test-db run docker:db && pnpm run db:gen && pnpm run db:push",
    "docker:db:down": "pnpm --filter=test-db run docker:db:down",
    "docker:db:seed": "pnpm --filter=test-db run db:seed",
    "docker:up": "docker-compose up",
    "dev": "turbo run dev --filter=web --filter=api2",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "cypress:ci": "start-server-and-test storybook http://localhost:9009 cypress:run",
    "cypress:dev": "cypress open",
    "cypress:run": "cypress run",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "reset": "turbo run reset && pnpm install",
    "start": "turbo run start",
    "storybook": "pnpm run --filter=@repo/ui storybook",
    "studio": "turbo run studio",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=web",
    "test:api": "turbo run test --filter=api",
    "test:ci": "pnpm check-types && jest --ci && pnpm cypress:ci"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.2",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@biomejs/biome": "1.8.3",
    "@radix-ui/react-dialog": "^1.1.1",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@testing-library/cypress": "^10.0.2",
    "@testing-library/dom": "^10.2.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "babel-jest": "^29.7.0",
    "cypress": "^13.13.1",
    "cypress-real-events": "^1.13.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-axe": "^6.0.1",
    "jest-extended": "^4.0.2",
    "start-server-and-test": "2.0.3",
    "text-encoding-polyfill": "^0.6.7",
    "turbo": "^2.0.10"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=7.0.0"
  },
  "packageManager": "pnpm@9.7.0",
  "dependencies": {
    "rimraf": "^6.0.1"
  }
}
