{
	"name": "squared",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"api:gen": "pnpm run --filter=api gen",
		"build": "turbo run build",
		"build:icons": "pnpm --filter=@squared/icons run build",
		"build:rpc": "pnpm --filter=@squared/rpc run build && pnpm --filter=@squared/rpc-client run build",
		"build:ui": "pnpm --filter=@squaredmade/ui run build",
		"check-types": "turbo run check-types",
		"clean": "turbo run clean && rimraf node_modules",
		"db:backup:staging": "pnpm --filter=db db:backup:staging",
		"db:backup:prod": "pnpm --filter=db db:backup:prod",
		"db:gen": "turbo run db:gen",
		"db:migrate": "pnpm --filter=@squared/db db:migrate",
		"db:push": "pnpm --filter=@squared/db db:push",
		"dev": "turbo run dev",
		"dev:go": "turbo run dev:go",
		"docker:build": "docker compose build",
		"docker:db": "pnpm --filter=@squared/seed run docker:db",
		"docker:db:down": "pnpm --filter=@squared/seed run docker:db:down",
		"docker:db:init": "pnpm docker:db && pnpm docker:db:seed && pnpm db:migrate",
		"docker:db:rebuild": "pnpm docker:db:down && pnpm docker:db:init",
		"docker:db:seed": "pnpm --filter=@squared/seed run db:seed",
		"docker:up": "docker compose up",
		"format:check": "biome format .",
		"format:write": "biome format --write . && biome check --formatter-enabled=false --linter-enabled=false --organize-imports-enabled=true --write .",
		"knip": "knip",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"prepare": "husky",
		"reset": "pnpm clean && pnpm install",
		"slicemachine": "pnpm run --filter=www slicemachine",
		"start": "turbo run start",
		"storybook": "pnpm run --filter=@squaredmade/ui storybook",
		"studio": "turbo run studio",
		"test": "turbo run test",
		"test:api": "turbo run test --filter=api",
		"test:ci": "pnpm check-types && pnpm lint && pnpm test && pnpm build",
		"test:web": "turbo run test --filter=web"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@commitlint/cli": "^19.3.0",
		"@commitlint/config-conventional": "^19.4.1",
		"husky": "^9.1.7",
		"knip": "^5.29.1",
		"rimraf": "^6.0.1",
		"turbo": "^2.1.0",
		"turbo-ignore": "^2.1.0"
	},
	"engines": {
		"node": ">=23.0.0",
		"npm": ">=10.0.0"
	},
	"pnpm": {
		"supportedArchitectures": {
			"os": ["win32", "darwin", "current"],
			"cpu": ["x64", "arm64"]
		},
		"overrides": {
			"@types/react": "19.0.8",
			"@types/react-dom": "19.0.3"
		}
	},
	"packageManager": "pnpm@9.15.4"
}
