{
  "name": "squared",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "api:gen": "pnpm run --filter=api gen",
    "build": "turbo run build",
    "build:icons": "pnpm --filter=@repo/ui run build",
    "db:backup": "cd ./packages/db && dotenv -e .env -- sh -c 'echo $POSTGRES_PRISMA_URL && pg_dump --file=../../database/$(date +%d-%m-%Y).bak --dbname=$(echo $POSTGRES_PRISMA_URL | sed \"s/[?&]pgbouncer=true//\")'",
    "db:gen": "turbo run db:gen",
    "db:deploy": "pnpm --filter=@squared/db db:deploy",
    "db:push": "pnpm --filter=@squared/db db:push",
    "docker:build": "docker compose build",
    "docker:db:init": "pnpm docker:db && pnpm docker:db:seed",
    "docker:db": "pnpm --filter=@squared/seed run docker:db && pnpm run db:gen && pnpm db:deploy",
    "docker:db:down": "pnpm --filter=@squared/seed run docker:db:down",
    "docker:db:seed": "pnpm --filter=@squared/seed run db:seed",
    "docker:up": "docker compose up",
    "docker:db:rebuild": "pnpm docker:db:down && pnpm docker:db:init",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "format:write": "biome format --write . && biome check --formatter-enabled=false --linter-enabled=false --organize-imports-enabled=true --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "reset": "turbo run reset && pnpm install",
    "start": "turbo run start",
    "storybook": "pnpm run --filter=@repo/ui storybook",
    "studio": "turbo run studio",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=web",
    "test:api": "turbo run test --filter=api",
    "test:ci": "pnpm check-types && pnpm lint && pnpm test && pnpm build",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.4.1",
    "@types/node": "^22.5.2",
    "dotenv-cli": "^7.4.2",
    "husky": "^9.1.5",
    "knip": "^5.29.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.0",
    "turbo-ignore": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=23.0.0",
    "npm": ">=10.0.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "win32",
        "darwin",
        "current"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  },
  "packageManager": "pnpm@9.14.4"
}