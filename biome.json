{
  "$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
  "files": {
    "ignore": ["node_modules"],
    "include": ["src"]
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useKeyWithClickEvents": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      }
    }
  },
  "overrides": [
    {
      "include": ["packages/ui/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "a11y": {
            "useButtonType": "off",
            "noSvgWithoutTitle": "off",
            "useValidAnchor": "off"
          },
          "correctness": {
            "noChildrenProp": "off"
          },
          "complexity": {
            "noForEach": "off"
          },
          "performance": {
            "noAccumulatingSpread": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "globals": [
      "$",
      "_",
      "externalVariable",
      "cypress",
      "it",
      "cy",
      "describe",
      "beforeEach",
      "jest",
      "React",
      "afterEach",
      "Cypress"
    ]
  }
}
