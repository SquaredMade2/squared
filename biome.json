{
	"$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedKeys": "on"
			}
		},
		"enabled": true
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": true,
		"includes": [
			"**",
			"!**/.turbo/**",
			"!**/coverage/**",
			"!**/dist/**",
			"!**/build/**",
			"!**/.next/**",
			"!**/node_modules/**",
			"!**/bun.lock",
			"!**/*.md"
		],
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"linter": {
		"domains": {
			"project": "all"
		},
		"enabled": true,
		"includes": [
			"**",
			"!**/gen/rpc/**",
			"!**/.turbo/**",
			"!**/coverage/**",
			"!**/dist/**",
			"!**/build/**",
			"!**/.next/**",
			"!**/node_modules/**",
			"!**/bun.lock",
			"!**/*.md"
		],
		"rules": {
			"complexity": {
				"noForEach": "error",
				"noVoid": "error",
				"useSimplifiedLogicExpression": "error",
				"useWhile": "error"
			},
			"correctness": {
				"useImportExtensions": "off"
			},
			"nursery": {
				"noAwaitInLoop": "warn",
				"noConstantBinaryExpression": "warn",
				"noFloatingPromises": "off",
				"noImportCycles": "off",
				"noShadow": "warn",
				"noTsIgnore": "warn",
				"noUnresolvedImports": "off",
				"useAdjacentGetterSetter": "warn",
				"useConsistentObjectDefinition": "warn",
				"useConsistentResponse": "warn",
				"useIterableCallbackReturn": "warn",
				"useNumericSeparators": "warn",
				"useObjectSpread": "warn",
				"useSingleJsDocAsterisk": "warn",
				"useSymbolDescription": "warn"
			},
			"performance": {
				"noDelete": "error",
				"noNamespaceImport": "error",
				"noReExportAll": "error",
				"useTopLevelRegex": "error"
			},
			"recommended": true,
			"style": {
				"noCommonJs": "error",
				"noImplicitBoolean": "error",
				"noInferrableTypes": "error",
				"noNamespace": "error",
				"noNegationElse": "error",
				"noNestedTernary": "error",
				"noParameterAssign": "error",
				"noParameterProperties": "error",
				"noProcessEnv": "error",
				"noRestrictedGlobals": {
					"level": "error",
					"options": {
						"deniedGlobals": {
							"event": "Use the event parameter instead",
							"length": "Use a more descriptive variable name",
							"name": "Use a more descriptive variable name"
						}
					}
				},
				"noShoutyConstants": "error",
				"noSubstr": "error",
				"noUnusedTemplateLiteral": "error",
				"noUselessElse": "error",
				"noYodaExpression": "error",
				"useAsConstAssertion": "error",
				"useAtIndex": { "fix": "safe", "level": "error" },
				"useCollapsedElseIf": "error",
				"useCollapsedIf": "error",
				"useConsistentArrayType": {
					"fix": "safe",
					"level": "error",
					"options": { "syntax": "shorthand" }
				},
				"useConsistentBuiltinInstantiation": "error",
				"useConsistentCurlyBraces": { "fix": "safe", "level": "error" },
				"useConsistentMemberAccessibility": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useExplicitLengthCheck": { "fix": "safe", "level": "error" },
				"useFilenamingConvention": "warn",
				"useForOf": "error",
				"useFragmentSyntax": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"requireAscii": true,
						"strictCase": false
					}
				},
				"useNodeAssertStrict": "error",
				"useNumberNamespace": "error",
				"useSelfClosingElements": "error",
				"useShorthandAssign": { "fix": "safe", "level": "error" },
				"useSingleVarDeclarator": "error",
				"useThrowNewError": "error",
				"useThrowOnlyError": "error",
				"useTrimStartEnd": "error"
			},
			"suspicious": {
				"noConsole": { "fix": "safe", "level": "error" },
				"noEmptyBlockStatements": "error",
				"noEvolvingTypes": "error",
				"noSkippedTests": "error",
				"useAwait": "error",
				"useErrorMessage": "error",
				"useGuardForIn": "error",
				"useNumberToFixedDigitsArgument": "error",
				"useStrictMode": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.test.js",
				"**/*.test.jsx",
				"**/__tests__/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noProcessEnv": "off",
						"useNamingConvention": "off",
						"useThrowOnlyError": "off"
					},
					"suspicious": {
						"noConsole": "off",
						"noExplicitAny": "off",
						"useAwait": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.js"],
			"linter": {
				"rules": {
					"style": {
						"noCommonJs": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.config.ts",
				"**/*.config.js",
				"**/*.config.cjs",
				"**/*.config.mjs"
			],
			"linter": {
				"enabled": false
			}
		},
		{
			"assist": {
				"actions": {
					"source": {
						"useSortedKeys": "off"
					}
				}
			},
			"includes": ["**/package.json"]
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": false,
		"useIgnoreFile": true
	}
}
