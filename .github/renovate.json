{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:base"],
	"schedule": ["at any time"],
	"prConcurrentLimit": 50,
	"labels": ["Updates"],
	"dependencyDashboard": true,
	"automerge": true,
	"automergeType": "pr",
	"automergeStrategy": "auto",
	"requiredStatusChecks": [],
	"platformAutomerge": true,
	"minimumReleaseAge": "3 days",
	"reviewers": ["team:squared-developers"],
	"packageRules": [
		{
			"matchManagers": [
				"npm",
				"nvm",
				"gomod",
				"dockerfile",
				"docker-compose",
				"github-actions"
			],
			"description": "Update dependencies",
			"matchCurrentAge": "3 days"
		},
		{
			"matchPackageNames": [
				"@squaredmade/builder",
				"@squaredmade/context",
				"@squaredmade/db",
				"@squaredmade/fonts",
				"@squaredmade/icons",
				"@squaredmade/logger",
				"@squaredmade/rpc",
				"@squaredmade/rpc-client",
				"@squaredmade/superjson",
				"@squaredmade/typescript-config",
				"@squaredmade/ui"
			],
			"description": "Internal packages"
		}
	]
}
