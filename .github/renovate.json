{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base"
    ],
    "schedule": [
        "on the first day of the month"
    ],
    "prConcurrentLimit": 20,
    "automerge": false,
    "stabilityDays": 60,
    "labels": [
        "Updates"
    ],
    "commitMessagePrefix": "[skip ci][skip vercel]",
    "packageRules": [
        {
            "matchManagers": [
                "npm"
            ],
            "matchPaths": [
                "apps/{web,www}/**",
                "apps/api/**",
                "packages/**"
            ],
            "labels": [
                "Fullstack Updates",
                "Updates"
            ],
            "reviewers": [
                "@SquaredMade2/fullstack-developers"
            ]
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchPaths": [
                "apps/web/**",
                "apps/www/**"
            ],
            "labels": [
                "Frontend Updates",
                "Updates"
            ],
            "reviewers": [
                "@SquaredMade2/frontend-developers"
            ]
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchPaths": [
                "apps/api/**"
            ],
            "labels": [
                "Backend Updates",
                "Updates"
            ],
            "reviewers": [
                "@SquaredMade2/backend-developers"
            ]
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchPaths": [
                "packages/**"
            ],
            "labels": [
                "Package Updates",
                "Updates"
            ],
            "reviewers": [
                "@SquaredMade2/squared-developers"
            ]
        },
        {
            "matchManagers": [
                "dockerfile",
                "docker-compose"
            ],
            "labels": [
                "DevOps Updates",
                "Updates"
            ],
            "reviewers": [
                "@SquaredMade2/devops-engineers"
            ]
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "labels": [
                "CI/CD Updates",
                "Updates"
            ],
            "reviewers": [
                "@SquaredMade2/devops-engineers"
            ]
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchPaths": [
                "!(apps|packages)/**"
            ],
            "labels": [
                "Updates"
            ],
            "reviewers": [
                "@SquaredMade2/squared-developers"
            ]
        }
    ]
}