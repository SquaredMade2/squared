{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:base"],
	"schedule": ["at any time"],
	"prConcurrentLimit": 50,
	"labels": ["Updates"],
	"dependencyDashboard": true,
	"automerge": true,
	"automergeType": "pr",
	"automergeStrategy": "auto",
	"requiredStatusChecks": [],
	"platformAutomerge": true,
	"minimumReleaseAge": "3 days",
	"packageRules": [
		{
			"matchManagers": [
				"npm",
				"nvm",
				"gomod",
				"dockerfile",
				"docker-compose",
				"github-actions"
			],
			"reviewers": ["team:squared-developers"],
			"stabilityDays": 3
		},
		{
			"matchPackagePatterns": ["^@squaredmade/"],
			"groupName": "squaredmade packages",
			"schedule": ["at any time"],
			"minimumReleaseAge": "0",
			"stabilityDays": 0,
			"reviewers": ["team:squared-developers"],
			"prCreation": "immediate"
		}
	]
}
