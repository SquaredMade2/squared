{
    "extends": [
        "config:base"
    ],
    "schedule": [
        "on the first day of the month"
    ],
    "prConcurrentLimit": 20,
    "automerge": false,
    "stabilityDays": 60,
    "labels": [
        "Updates"
    ],
    "packageRules": [
        {
            "packagePatterns": [
                "*"
            ],
            "enabledManagers": [
                "npm",
                "nvm",
                "dockerfile",
                "docker-compose",
                "github-actions"
            ],
            "automerge": false,
            "schedule": [
                "on the first day of the month"
            ],
            "labels": [
                "Updates"
            ],
            "assignees": [
                "team:squared-developers"
            ]
        },
        {
            "packagePatterns": [
                "*"
            ],
            "paths": [
                "apps/web"
            ],
            "assignees": [
                "team:frontend-developers"
            ],
            "labels": [
                "Frontend Updates"
            ]
        },
        {
            "packagePatterns": [
                "*"
            ],
            "paths": [
                "apps/www"
            ],
            "assignees": [
                "team:frontend-developers"
            ],
            "labels": [
                "Frontend Updates"
            ]
        },
        {
            "packagePatterns": [
                "*"
            ],
            "paths": [
                "apps/api"
            ],
            "assignees": [
                "team:backend-developers"
            ],
            "labels": [
                "Backend Updates"
            ]
        },
        {
            "packagePatterns": [
                "*"
            ],
            "paths": [
                "packages/**/*"
            ],
            "assignees": [
                "team:squared-developers"
            ],
            "labels": [
                "Package Updates"
            ]
        },
        {
            "packagePatterns": [
                "*"
            ],
            "paths": [
                "apps/web",
                "apps/api",
                "packages/**/*"
            ],
            "assignees": [
                "team:fullstack-developers"
            ],
            "labels": [
                "Fullstack Updates"
            ]
        }
    ]
}