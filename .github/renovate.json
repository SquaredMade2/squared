{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base"
    ],
    "schedule": [
        "on the first day of the month"
    ],
    "prConcurrentLimit": 20,
    "labels": [
        "Updates"
    ],
    "commitMessagePrefix": "[skip vercel]",
    "packageRules": [
        {
            "matchManagers": [
                "npm",
                "dockerfile",
                "docker-compose",
                "github-actions"
            ],
            "reviewers": [
                "team:squared-developers"
            ]
        }
    ]
}