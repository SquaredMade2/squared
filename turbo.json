{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["NEXT_PUBLIC_API_HOST"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [
				"dist/**",
				".next/**",
				"!.next/cache/**",
				"public/dist/**",
				"bin/**"
			]
		},
		"build:go": {
			"dependsOn": ["^build:go"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"cmd/**/*.go",
				"internal/**/*.go",
				"pkg/**/*.go",
				"*.go"
			],
			"outputs": ["bin/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"clean": {
			"cache": false
		},
		"db:gen": {
			"cache": false,
			"dependsOn": ["^db:gen"]
		},
		"db:push": {
			"dependsOn": ["^db:push"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:go": {
			"cache": false,
			"persistent": true
		},
		"format": {
			"dependsOn": ["^format"]
		},
		"format:check": {
			"dependsOn": ["^format:check"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"lint:fix": {
			"dependsOn": ["^lint:fix"]
		},
		"start": {
			"dependsOn": ["^start", "build"]
		},
		"studio": {
			"dependsOn": ["^studio"]
		},
		"test": {
			"dependsOn": []
		},
		"test-ci": {
			"dependsOn": ["^test-ci", "^test"]
		},
		"web#build": {
			"dependsOn": ["^build"],
			"env": [
				"NEXT_PUBLIC_SERVER",
				"NEXT_PUBLIC_URL",
				"CLERK_SECRET_KEY",
				"PORT"
			]
		}
	},
	"ui": "tui"
}
