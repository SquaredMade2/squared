{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NEXT_PUBLIC_API_HOST"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "public/dist/**"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "clean": {
      "cache": false
    },
    "db:gen": {
      "dependsOn": [
        "^db:gen"
      ],
      "cache": false
    },
    "db:push": {
      "dependsOn": [
        "^db:push"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format:check": {
      "dependsOn": [
        "^format:check"
      ]
    },
    "format:write": {
      "dependsOn": [
        "^format:write"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^lint:fix"
      ]
    },
    "reset": {
      "dependsOn": [
        "^reset"
      ]
    },
    "start": {
      "dependsOn": [
        "^start",
        "build"
      ]
    },
    "studio": {
      "dependsOn": [
        "^studio"
      ]
    },
    "test": {
      "dependsOn": [],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:ci": {
      "dependsOn": [
        "^test:ci"
      ]
    }
  },
  "ui": "tui"
}