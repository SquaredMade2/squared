{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "public/dist/**"
      ],
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NEXT_PUBLIC_API_HOST"
      ]
    },
    "start": {
      "dependsOn": [
        "^start",
        "build"
      ]
    },
    "test": {
      "outputs": [
        "coverage/**"
      ],
      "dependsOn": []
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^lint:fix"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "types:check": {
      "dependsOn": [
        "^types:check"
      ]
    },
    "format:write": {
      "dependsOn": [
        "^format:write"
      ]
    },
    "format:check": {
      "dependsOn": [
        "^format:check"
      ]
    },
    "reset": {
      "dependsOn": [
        "^reset"
      ]
    }
  }
}