{
	"name": "api",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"build": "tsc",
		"check-types": "tsc --pretty --noEmit",
		"dev": "concurrently \"npm run watch-typescript\" \"npm run hot-reload\"",
		"format:check": "biome format .",
		"format:write": "biome format --write .",
		"hot-reload": "nodemon dist/index.js",
		"reset": "rimraf node_modules pnpm-lock.yaml",
		"seed": "tsc && node ./dist/utils/DBSeed.js",
		"sentry:sourcemaps": "sentry-cli sourcemaps inject --org squaredmade --project node-express ./dist && sentry-cli sourcemaps upload --org squaredmade --project node-express ./dist",
		"start": "tsc && node dist/index.js",
		"test": "tsc && mocha ./dist/test --exit",
		"test:ci": "pnpm check-types && pnpm build",
		"update": "tsc && node ./dist/utils/updateDb.js",
		"watch-typescript": "npx tsc --watch",
		"webhook": "tsc && node ./dist/webhooks/octokit.js"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@9.5.0",
	"dependencies": {
		"@repo/jest-presets": "workspace:*",
		"@repo/logger": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@sentry/cli": "^2.22.2",
		"@sentry/node": "^7.81.1",
		"@types/jest": "^29.5.12",
		"aws-sdk": "^2.1498.0",
		"axios": "^1.7.2",
		"bcrypt": "^5.1.1",
		"bcryptjs": "^2.4.3",
		"cookie": "^0.6.0",
		"cookie-parser": "^1.4.6",
		"cors": "^2.8.5",
		"dotenv": "^16.1.4",
		"express": "^4.18.2",
		"heic-convert": "^2.1.0",
		"jsonwebtoken": "^9.0.0",
		"mongoose": "^6.11.4",
		"multer": "^1.4.5-lts.1",
		"nodemailer": "^6.9.7",
		"octokit": "^4.0.2",
		"sharp": "^0.33.4",
		"socket.io": "^4.7.4"
	},
	"devDependencies": {
		"@faker-js/faker": "^8.2.0",
		"@types/bcrypt": "^5.0.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/chai": "^4.3.11",
		"@types/cookie": "^0.5.1",
		"@types/cookie-parser": "^1.4.3",
		"@types/cors": "^2.8.13",
		"@types/express": "^4.17.17",
		"@types/heic-convert": "^1.2.3",
		"@types/jsonwebtoken": "^9.0.2",
		"@types/mocha": "^10.0.6",
		"@types/multer": "^1.4.10",
		"@types/node": "^20.5.9",
		"@types/swagger-jsdoc": "^6.0.3",
		"chai": "^4.3.10",
		"chai-http": "^4.4.0",
		"concurrently": "^8.2.2",
		"husky": "^9.1.4",
		"mocha": "^10.2.0",
		"nodemon": "^3.0.1",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.0",
		"tslib": "^2.6.3",
		"typescript": "^5.1.6"
	}
}
