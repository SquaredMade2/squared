{
	"name": "api",
	"version": "1.0.0",
	"description": "",
	"main": "src/index.ts",
	"scripts": {
		"build": "pnpm run gen",
		"check-types": "tsc --noEmit",
		"dev": "nodemon src/api/index.ts",
		"gen": "ts-node src/api/generate-index.ts",
		"docker:api": "docker compose -f docker-compose.yml up -d",
		"docker:api:down": "docker compose -f docker-compose.yml down --volumes",
		"docker:api:stop": "docker stop api-test-1",
		"docker:api:start": "docker start api-test-1",
		"docker:api:update": "pnpm docker:api:stop && pnpm docker:api:update:src && pnpm docker:api:update:schema && pnpm docker:api:start",
		"docker:api:update:src": "docker cp ./src/. api-test-1:/app/apps/api/src",
		"docker:api:update:schema": "docker cp ../../packages/db/prisma/schema.prisma api-test-1:/app/packages/db/prisma",
		"format:check": "biome format .",
		"format:write": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"postinstall": "pnpm run gen",
		"start": "ts-node src/api/index.ts",
		"test": "pnpm docker:api && pnpm test:db:wait && sleep 5 && pnpm test:db:push && curl http://localhost:5174 -I && docker exec --workdir /app/apps/api api-test-1 pnpm jest --ci --runInBand",
		"test:db:push": "docker exec --workdir /app api-test-1 pnpm db:push",
		"test:db:reset": "docker exec --workdir /app/packages/db api-test-1 npx prisma migrate reset --force",
		"test:db:wait": "docker cp ./wait.sh postgres-api-test-db:/ && docker exec postgres-api-test-db chmod +x /wait.sh && docker exec -i postgres-api-test-db /bin/sh /./wait.sh"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@repo/db": "workspace:*",
		"@repo/logger": "workspace:*",
		"@vercel/postgres": "^0.10.0",
		"axios": "^1.7.5",
		"bcrypt": "^5.1.1",
		"bcryptjs": "^2.4.3",
		"cors": "^2.8.5",
		"date-fns": "^4.0.0",
		"dotenv": "^16.4.1",
		"dotenv-cli": "^7.4.2",
		"express": "^4.18.2",
		"jsonwebtoken": "^9.0.2",
		"node-cron": "^3.0.3",
		"nodemailer": "^6.9.14",
		"qs": "^6.13.0",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.0",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"uuid": "^10.0.0"
	},
	"devDependencies": {
		"@swc/core": "^1.7.26",
		"@swc/jest": "^0.2.36",
		"@types/bcryptjs": "^2.4.6",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.12",
		"@types/jsonwebtoken": "^9.0.2",
		"@types/node": "^22.2.0",
		"@types/node-cron": "^3.0.11",
		"@types/nodemailer": "^6.4.15",
		"@types/qs": "^6.9.15",
		"@types/supertest": "^6.0.2",
		"@types/swagger-jsdoc": "^6.0.3",
		"@types/swagger-ui-express": "^4.1.6",
		"@types/uuid": "^10.0.0",
		"jest": "^29.7.0",
		"nodemon": "^3.0.1",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"typescript": "^5.5.4"
	}
}