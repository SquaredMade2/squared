		"start": "ts-node src/api/index.ts",
		"test": "(pnpm --filter=@repo/test-db db:test:push && dotenv -e .env.run.test jest && pnpm --filter=@repo/test-db db:test:reset) || pnpm --filter=@repo/test-db db:test:reset"
	},
	"keywords": [],
