{
	"ts-node": {
		"require": ["tsconfig-paths/register"]
	},
	"compilerOptions": {
		"target": "ES2020",
		"module": "node16",
		"outDir": "./dist",
		"rootDir": "./api",
		"typeRoots": ["./node_modules/@types"],
		"types": ["node", "express"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": "."
	},
	"include": ["api/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
