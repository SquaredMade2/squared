{
	"ts-node": {
		"require": ["tsconfig-paths/register"]
	},
	"compilerOptions": {
		"target": "ES2020",
		"module": "node16",
		"outDir": "./dist",
		"rootDir": "./api",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["*"]
		}
	},
	"include": ["api/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
