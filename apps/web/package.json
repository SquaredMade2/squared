{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:digitalocean": "pnpm install --production=false && pnpm run build && rm -rf node_modules && pnpm install --production --frozen-lockfile",
    "build-storybook": "storybook build",
    "format:write": "biome format --write .",
    "format:check": "biome format .",
    "check-types": "tsc --pretty --noEmit",
    "cypress": "cypress open",
    "cypress:components": "cypress run --component",
    "cypress:headless": "cypress run",
    "dev": "next dev",
    "format": "biome format --write .",
    "jest": "jest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "prestart": "pnpm i",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test-all": "pnpm run format && pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "@repo/biome-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@chromatic-com/storybook": "^1.5.0",
    "@commitlint/cli": "^17.8.1",
    "@storybook/addon-essentials": "^8.1.5",
    "@storybook/addon-interactions": "^8.1.5",
    "@storybook/addon-links": "^8.1.5",
    "@storybook/addon-onboarding": "^8.1.5",
    "@storybook/blocks": "^8.1.5",
    "@storybook/nextjs": "^8.1.5",
    "@storybook/test": "^8.1.5",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/cypress": "^9.0.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-mentions": "^4.1.13",
    "autoprefixer": "^10.4.19",
    "cypress": "^12.17.4",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^14.0.1",
    "next": "^14.2.4",
    "postcss": "^8.4.38",
    "storybook": "^8.1.5",
    "tailwindcss": "^3.4.4"
  }
}
