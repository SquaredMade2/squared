{
  "id": "step_by_step_guide",
  "type": "SharedSlice",
  "name": "StepByStepGuide",
  "description": "StepByStepGuide",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "guide_title": {
          "type": "Text",
          "config": {
            "label": "Guide Title",
            "placeholder": "Enter the title of the guide"
          }
        },
        "steps": {
          "type": "Group",
          "config": {
            "label": "Steps",
            "repeat": true,
            "fields": {
              "step": {
                "type": "StructuredText",
                "config": {
                  "label": "Step",
                  "placeholder": "Describe this step...",
                  "allowTargetBlank": true,
                  "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
                }
              },
              "step_image": {
                "type": "Image",
                "config": {
                  "label": "Step Image",
                  "constraint": {},
                  "thumbnails": []
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}