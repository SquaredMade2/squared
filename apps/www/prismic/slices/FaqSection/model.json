{
	"id": "faq_section",
	"type": "SharedSlice",
	"name": "FaqSection",
	"description": "FaqSection",
	"variations": [
		{
			"id": "default",
			"name": "Default",
			"docURL": "...",
			"version": "initial",
			"description": "Default",
			"imageUrl": "",
			"primary": {
				"section_title": {
					"type": "Text",
					"config": {
						"label": "Section Title",
