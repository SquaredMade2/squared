{
	"format": "page",
	"id": "docs",
	"label": "Docs Landing Page",
	"repeatable": false,
	"status": true,
	"json": {
		"Main": {
			"title": {
				"type": "Text",
				"config": {
					"label": "Title",
					"placeholder": "Documentation"
				}
			},
			"introduction": {
				"type": "StructuredText",
				"config": {
					"label": "Introduction",
					"placeholder": "Welcome to our documentation...",
					"allowTargetBlank": true,
					"multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl"
				}
			},
			"featured_sections": {
				"type": "Group",
				"config": {
					"label": "Featured Sections",
					"repeat": true,
					"fields": {
						"section": {
							"type": "Link",
							"config": {
								"label": "Section",
								"select": "document",
								"repeat": false,
								"customtypes": ["documentation"]
							}
						},
						"description": {
							"type": "Text",
							"config": {
								"label": "Description",
								"placeholder": "Brief description of this section"
							}
						}
					}
				}
			},
			"slices": {
				"type": "Slices",
				"fieldset": "Slice Zone",
				"config": {
					"choices": {
						"text_section": {
							"type": "SharedSlice"
						},
						"step_by_step_guide": {
							"type": "SharedSlice"
						}
					}
				}
			}
		},
		"SEO & Metadata": {
			"meta_title": {
				"config": {
					"label": "Meta Title",
					"placeholder": "A title of the page used for social media and search engines"
				},
				"type": "Text"
			},
			"meta_description": {
				"config": {
					"label": "Meta Description",
					"placeholder": "A brief summary of the page"
				},
				"type": "Text"
			},
			"meta_image": {
				"config": {
					"constraint": {
						"height": 1260,
						"width": 2400
					},
					"label": "Meta Image",
					"thumbnails": []
				},
				"type": "Image"
			}
		}
	}
}
