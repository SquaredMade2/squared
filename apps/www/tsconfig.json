{
	"extends": "@squared/typescript-config/nextjs.json",
	"compilerOptions": {
		"outDir": "dist/",
		"baseUrl": ".",
		"paths": {
			"@/*": ["*"]
		},
		"moduleResolution": "Bundler",
		"module": "ESNext",
		"types": ["node"],
		"typeRoots": ["./node_modules/@types"],
		"jsx": "react-jsx"
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": [".next"]
}
