{
  "private": true,
  "name": "@repo/ui",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "ssr-testing",
    "packages/*/*"
  ],
  "scripts": {
    "build-storybook": "storybook build",
    "build": "node build.mjs",
    "clean": "pnpm workspaces foreach -pvW --exclude primitives --exclude ssr-testing run clean",
    "cypress:ci": "start-server-and-test storybook http://localhost:9009 cypress:run",
    "dev": "pnpm storybook",
    "reset": "pnpm clean && rm -rf node_modules .pnpm/cache",
    "storybook": "BROWSER=none storybook dev -p 9009",
    "test": "jest",
    "test:ci": "pnpm types:check && jest --ci && pnpm cypress:ci",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/node": "^22.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
