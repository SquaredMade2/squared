{
  "private": true,
  "name": "ui",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "ssr-testing",
    "packages/*/*"
  ],
  "scripts": {
    "test": "jest",
    "test:ci": "pnpm types:check && jest --ci && pnpm cypress:ci",
    "storybook": "BROWSER=none storybook dev -p 9009",
    "cypress:ci": "start-server-and-test storybook http://localhost:9009 cypress:run",
    "dev": "pnpm storybook",
    "build-storybook": "storybook build",
    "build": "node build.mjs",
    "publish:stable": "pnpm bump:stable && pnpm clean && pnpm build && pnpm workspaces foreach -pvW --exclude primitives --exclude ssr-testing npm publish --tolerate-republish --access public",
    "publish:next": "pnpm bump:next && pnpm clean && pnpm build && pnpm workspaces foreach -pvW --exclude primitives --exclude ssr-testing npm publish --tolerate-republish --access public --tag next",
    "clean": "pnpm workspaces foreach -pvW --exclude primitives --exclude ssr-testing run clean",
    "reset": "pnpm clean && rm -rf node_modules .pnpm/cache",
    "bump:stable": "pnpm version apply --all",
    "bump:next": "pnpm version apply --all --prerelease",
    "bump:check": "pnpm version check"
  },
  "dependencies": {
    "@types/node": "^22.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@stitches/core": "^1.2.8",
    "@storybook/addon-essentials": "^7.6.17",
    "@storybook/addon-storysource": "^7.6.17",
    "@storybook/react": "^7.6.17",
    "@storybook/react-webpack5": "^7.6.17",
    "@storybook/test": "^7.6.17",
    "@testing-library/cypress": "^7.0.6",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.1.0",
    "@types/fs-extra": "^11",
    "@types/jest": "^27.4.1",
    "@types/jest-axe": "^3.5.3",
    "@types/react": "^18.0.5",
    "@types/react-dom": "^18.0.0",
    "@types/react-test-renderer": "^18.0.0",
    "cypress": "^8.0.0",
    "cypress-real-events": "^1.5.0",
    "esbuild": "0.21.4",
    "fs-extra": "^11.1.1",
    "glob": "^10.2.2",
    "husky": "^4.3.6",
    "jest": "^27.5.1",
    "jest-axe": "^6.0.0",
    "jest-watch-typeahead": "^1.0.0",
    "lint-staged": "^10.5.3",
    "pretty-quick": "^2.0.1",
    "react-test-renderer": "^18.0.0",
    "replace-in-files": "^3.0.0",
    "start-server-and-test": "2.0.3",
    "storybook": "^7.6.17",
    "ts-jest": "^27.1.4",
    "tsup": "8.0.2",
    "typescript": "^4.6.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/packages"
    ],
    "testMatch": [
      "**/?(*.)+(test).+(ts|tsx|js)"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "moduleNameMapper": {
      "@squared-ui/react-(.+)$": "<rootDir>/packages/react/$1/src",
      "@squared-ui/(.+)$": "<rootDir>packages/core/$1/src"
    },
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/scripts/setup-tests.ts",
      "jest-axe/extend-expect"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged && lint-staged",
      "pre-push": "pnpm types:check && pnpm bump:check"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "biome lint --write"
  },
  "packageManager": "pnpm@9.6.0"
}