{
  "include": ["components", "types", "scripts"],
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "alwaysStrict": true,
    "baseUrl": ".",
    "declaration": true,
    "emitDecoratorMetadata": false,
    "esModuleInterop": true,
    "experimentalDecorators": false,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext", "DOM.Iterable"],
    "moduleResolution": "node",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "pretty": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "stripInternal": true,
    "target": "ES2022",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./types"],
    "paths": {
      "@squared-ui/number": ["./components/core/number/src"],
      "@squared-ui/primitive": ["./components/core/primitive/src"],
      "@squared-ui/rect": ["./components/core/rect/src"],
      "@squared-ui/react-accessible-icon": ["./components/react/accessible-icon/src"],
      "@squared-ui/react-accordion": ["./components/react/accordion/src"],
      "@squared-ui/react-alert-dialog": ["./components/react/alert-dialog/src"],
      "@squared-ui/react-announce": ["./components/react/announce/src"],
      "@squared-ui/react-arrow": ["./components/react/arrow/src"],
      "@squared-ui/react-aspect-ratio": ["./components/react/aspect-ratio/src"],
      "@squared-ui/react-avatar": ["./components/react/avatar/src"],
      "@squared-ui/react-checkbox": ["./components/react/checkbox/src"],
      "@squared-ui/react-collapsible": ["./components/react/collapsible/src"],
      "@squared-ui/react-collection": ["./components/react/collection/src"],
      "@squared-ui/react-compose-refs": ["./components/react/compose-refs/src"],
      "@squared-ui/react-context": ["./components/react/context/src"],
      "@squared-ui/react-context-menu": ["./components/react/context-menu/src"],
      "@squared-ui/react-dialog": ["./components/react/dialog/src"],
      "@squared-ui/react-direction": ["./components/react/direction/src"],
      "@squared-ui/react-dismissable-layer": ["./components/react/dismissable-layer/src"],
      "@squared-ui/react-dropdown-menu": ["./components/react/dropdown-menu/src"],
      "@squared-ui/react-focus-guards": ["./components/react/focus-guards/src"],
      "@squared-ui/react-focus-scope": ["./components/react/focus-scope/src"],
      "@squared-ui/react-form": ["./components/react/form/src"],
      "@squared-ui/react-hover-card": ["./components/react/hover-card/src"],
      "@squared-ui/react-id": ["./components/react/id/src"],
      "@squared-ui/react-label": ["./components/react/label/src"],
      "@squared-ui/react-menu": ["./components/react/menu/src"],
      "@squared-ui/react-menubar": ["./components/react/menubar/src"],
      "@squared-ui/react-navigation-menu": ["./components/react/navigation-menu/src"],
      "@squared-ui/react-popover": ["./components/react/popover/src"],
      "@squared-ui/react-popper": ["./components/react/popper/src"],
      "@squared-ui/react-portal": ["./components/react/portal/src"],
      "@squared-ui/react-presence": ["./components/react/presence/src"],
      "@squared-ui/react-primitive": ["./components/react/primitive/src"],
      "@squared-ui/react-progress": ["./components/react/progress/src"],
      "@squared-ui/react-radio-group": ["./components/react/radio-group/src"],
      "@squared-ui/react-roving-focus": ["./components/react/roving-focus/src"],
      "@squared-ui/react-scroll-area": ["./components/react/scroll-area/src"],
      "@squared-ui/react-select": ["./components/react/select/src"],
      "@squared-ui/react-separator": ["./components/react/separator/src"],
      "@squared-ui/react-slider": ["./components/react/slider/src"],
      "@squared-ui/react-slot": ["./components/react/slot/src"],
      "@squared-ui/react-switch": ["./components/react/switch/src"],
      "@squared-ui/react-tabs": ["./components/react/tabs/src"],
      "@squared-ui/react-toast": ["./components/react/toast/src"],
      "@squared-ui/react-toggle": ["./components/react/toggle/src"],
      "@squared-ui/react-toggle-group": ["./components/react/toggle-group/src"],
      "@squared-ui/react-toolbar": ["./components/react/toolbar/src"],
      "@squared-ui/react-tooltip": ["./components/react/tooltip/src"],
      "@squared-ui/react-use-callback-ref": ["./components/react/use-callback-ref/src"],
      "@squared-ui/react-use-controllable-state": ["./components/react/use-controllable-state/src"],
      "@squared-ui/react-use-escape-keydown": ["./components/react/use-escape-keydown/src"],
      "@squared-ui/react-use-layout-effect": ["./components/react/use-layout-effect/src"],
      "@squared-ui/react-use-previous": ["./components/react/use-previous/src"],
      "@squared-ui/react-use-rect": ["./components/react/use-rect/src"],
