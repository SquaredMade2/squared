{
  "include": ["src", "types", "scripts"],
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "alwaysStrict": true,
    "baseUrl": ".",
    "declaration": true,
    "emitDecoratorMetadata": false,
    "esModuleInterop": true,
    "experimentalDecorators": false,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext", "DOM.Iterable"],
    "moduleResolution": "node",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "pretty": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "stripInternal": true,
    "target": "ES2022",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./types"],
    "paths": {
      "@squared-ui/number": ["./src/core/number/src"],
      "@squared-ui/primitive": ["./src/core/primitive/src"],
      "@squared-ui/rect": ["./src/core/rect/src"],
      "@squared-ui/react-accessible-icon": ["./src/react/accessible-icon/src"],
      "@squared-ui/react-accordion": ["./src/react/accordion/src"],
      "@squared-ui/react-alert-dialog": ["./src/react/alert-dialog/src"],
      "@squared-ui/react-announce": ["./src/react/announce/src"],
      "@squared-ui/react-arrow": ["./src/react/arrow/src"],
      "@squared-ui/react-aspect-ratio": ["./src/react/aspect-ratio/src"],
      "@squared-ui/react-avatar": ["./src/react/avatar/src"],
      "@squared-ui/react-checkbox": ["./src/react/checkbox/src"],
      "@squared-ui/react-collapsible": ["./src/react/collapsible/src"],
      "@squared-ui/react-collection": ["./src/react/collection/src"],
      "@squared-ui/react-compose-refs": ["./src/react/compose-refs/src"],
      "@squared-ui/react-context": ["./src/react/context/src"],
      "@squared-ui/react-context-menu": ["./src/react/context-menu/src"],
      "@squared-ui/react-dialog": ["./src/react/dialog/src"],
      "@squared-ui/react-direction": ["./src/react/direction/src"],
      "@squared-ui/react-dismissable-layer": ["./src/react/dismissable-layer/src"],
      "@squared-ui/react-dropdown-menu": ["./src/react/dropdown-menu/src"],
      "@squared-ui/react-focus-guards": ["./src/react/focus-guards/src"],
      "@squared-ui/react-focus-scope": ["./src/react/focus-scope/src"],
      "@squared-ui/react-form": ["./src/react/form/src"],
      "@squared-ui/react-hover-card": ["./src/react/hover-card/src"],
      "@squared-ui/react-id": ["./src/react/id/src"],
      "@squared-ui/react-label": ["./src/react/label/src"],
      "@squared-ui/react-menu": ["./src/react/menu/src"],
      "@squared-ui/react-menubar": ["./src/react/menubar/src"],
      "@squared-ui/react-navigation-menu": ["./src/react/navigation-menu/src"],
      "@squared-ui/react-popover": ["./src/react/popover/src"],
      "@squared-ui/react-popper": ["./src/react/popper/src"],
      "@squared-ui/react-portal": ["./src/react/portal/src"],
      "@squared-ui/react-presence": ["./src/react/presence/src"],
      "@squared-ui/react-primitive": ["./src/react/primitive/src"],
      "@squared-ui/react-progress": ["./src/react/progress/src"],
      "@squared-ui/react-radio-group": ["./src/react/radio-group/src"],
      "@squared-ui/react-roving-focus": ["./src/react/roving-focus/src"],
      "@squared-ui/react-scroll-area": ["./src/react/scroll-area/src"],
      "@squared-ui/react-select": ["./src/react/select/src"],
      "@squared-ui/react-separator": ["./src/react/separator/src"],
      "@squared-ui/react-slider": ["./src/react/slider/src"],
      "@squared-ui/react-slot": ["./src/react/slot/src"],
      "@squared-ui/react-switch": ["./src/react/switch/src"],
      "@squared-ui/react-tabs": ["./src/react/tabs/src"],
      "@squared-ui/react-toast": ["./src/react/toast/src"],
      "@squared-ui/react-toggle": ["./src/react/toggle/src"],
      "@squared-ui/react-toggle-group": ["./src/react/toggle-group/src"],
      "@squared-ui/react-toolbar": ["./src/react/toolbar/src"],
      "@squared-ui/react-tooltip": ["./src/react/tooltip/src"],
      "@squared-ui/react-use-callback-ref": ["./src/react/use-callback-ref/src"],
      "@squared-ui/react-use-controllable-state": ["./src/react/use-controllable-state/src"],
      "@squared-ui/react-use-escape-keydown": ["./src/react/use-escape-keydown/src"],
      "@squared-ui/react-use-layout-effect": ["./src/react/use-layout-effect/src"],
      "@squared-ui/react-use-previous": ["./src/react/use-previous/src"],
      "@squared-ui/react-use-rect": ["./src/react/use-rect/src"],
      "@squared-ui/react-use-size": ["./src/react/use-size/src"],
      "@squared-ui/react-visually-hidden": ["./src/react/visually-hidden/src"],
    }
  }
}
