{
	"ts-node": {
		"require": ["tsconfig-paths/register"],
		"compiler": "typescript"
	},
	"compilerOptions": {
		"target": "ES2020",
		"module": "node16",
		"rootDir": ".",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": "."
	},
	"include": ["src/index.ts"],
	"exclude": ["node_modules", "generated"]
}
