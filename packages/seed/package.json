{
	"name": "@squaredmade/seed",
	"version": "1.0.1",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"clean": "rimraf dist && rimraf node_modules",
		"db:seed": "cross-env NODE_ENV=test ts-node src/index.ts",
		"docker:db": "docker compose -f docker-compose.yml up -d",
		"docker:db:down": "docker compose -f docker-compose.yml down --volumes",
		"docker:db:check": "ts-node src/docker-check.ts",
		"docker:db:restore": "ts-node src/docker-restore.ts"
	},
	"dependencies": {
		"@squaredmade/logger": "1.1.2",
		"cross-env": "^7.0.3",
		"dotenv": "^16.5.0",
		"pg": "^8.16.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.1",
		"@types/pg": "^8.15.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
	}
}
