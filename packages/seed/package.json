{
	"name": "@squaredmade/seed",
	"version": "1.0.1",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"clean": "rimraf dist && rimraf node_modules",
		"db:seed": "cross-env NODE_ENV=test ts-node src/index.ts",
		"docker:db": "docker compose -f docker-compose.yml up -d",
		"docker:db:down": "docker compose -f docker-compose.yml down --volumes"
	},
	"dependencies": {
		"@squaredmade/logger": "1.1.1",
		"cross-env": "^7.0.3",
		"dotenv": "^16.4.1",
		"pg": "^8.13.1"
	},
	"devDependencies": {
		"@types/node": "^22.4.1",
		"@types/pg": "^8.11.11",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	}
}
