{
	"name": "@squared/seed",
	"version": "0.0.0",
	"private": true,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"db:seed": "cross-env NODE_ENV=test ts-node src/index.ts",
