		"docker:db:down": "docker compose -f docker-compose.yml down --volumes"
	},
	"dependencies": {
		"@squared/logger": "workspace:*",
		"cross-env": "^7.0.3",
		"dotenv": "^16.4.1",
		"pg": "^8.13.1"
	},
	"devDependencies": {
		"@types/node": "^22.4.1",
		"@types/pg": "^8.11.11",
		"ts-node": "^10.9.2"
	}
}
