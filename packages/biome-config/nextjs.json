{
  "extends": "./base.json",
  "files": {
    "include": ["next-env.d.ts"]
  },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": {
        "useKeyWithClickEvents": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      }
    }
  },
  "javascript": {
    "globals": [
      "$",
      "_",
      "externalVariable",
      "cypress",
      "it",
      "expect",
      "cy",
      "describe",
      "beforeEach",
      "jest",
      "React",
      "afterEach",
      "Cypress"
    ]
  }
}
