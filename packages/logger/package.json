{
  "name": "@squared/logger",
  "version": "0.1.0",
  "private": true,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome lint --error-on-warnings ./src",
    "postinstall": "tsup src/index.ts --format cjs,esm --dts"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@biomejs/biome": "1.9.3",
    "@types/node": "^22.5.1",
    "@types/winston": "^2.4.4",
    "typescript": "^5.5.4",
    "tsup": "^8.0.2"
  },
  "dependencies": {
    "winston": "^3.14.2"
  }
}