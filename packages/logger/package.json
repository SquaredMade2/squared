{
	"name": "@squaredmade/logger",
	"version": "1.0.0",
	"publishConfig": {
		"access": "public"
	},
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"check-types": "tsc --noEmit",
		"clean": "rimraf dist && rimraf node_modules",
		"lint": "biome lint --error-on-warnings ./src",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@squaredmade/builder": "^1.0.1",
		"@squaredmade/typescript-config": "^1.0.0",
		"@types/node": "^22.5.1",
		"@types/winston": "^2.4.4",
		"tsup": "^8.0.2",
		"typescript": "^5.7.3",
		"vitest": "^0.34.6"
	},
	"dependencies": {
		"winston": "^3.14.2"
	}
}
