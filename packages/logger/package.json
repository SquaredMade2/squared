{
	"name": "@squaredmade/logger",
	"version": "1.0.0",
	"private": true,
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --dts",
		"check-types": "tsc --noEmit",
		"clean": "rimraf dist && rimraf node_modules",
		"lint": "biome lint --error-on-warnings ./src",
		"prepare": "tsup src/index.ts --format cjs,esm --dts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@squaredmade/typescript-config": "workspace:*",
		"@types/node": "^22.5.1",
		"@types/winston": "^2.4.4",
		"tsup": "^8.0.2",
		"typescript": "^5.7.3",
		"vitest": "^0.34.6"
	},
	"dependencies": {
		"winston": "^3.14.2"
	}
}
