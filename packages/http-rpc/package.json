    "@squared/builder": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.6",
    "@types/node": "^20.8.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.7.0",
