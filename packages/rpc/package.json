{
	"name": "@squaredmade/rpc",
	"version": "1.0.0",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"clean": "rimraf dist && rimraf node_modules",
		"prepare": "pnpm run build",
		"prebuild": "rimraf dist",
		"prepublishOnly": "pnpm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@squaredmade/context": "workspace:*",
		"@squaredmade/logger": "workspace:*",
		"@squaredmade/superjson": "workspace:*",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@squaredmade/builder": "workspace:*",
		"@squaredmade/typescript-config": "workspace:*",
		"@types/express": "^5.0.0",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^3.0.7",
		"tslib": "^2.7.0",
		"typescript": "^5.2.2",
		"vitest": "^0.34.6"
	},
	"peerDependencies": {
		"express": "^4.18.2"
	}
}
