	},
	"devDependencies": {
		"@squared/builder": "workspace:*",
		"@squared/typescript-config": "workspace:*",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.6",
		"@types/node": "^22.0.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.1.1",
		"tslib": "^2.7.0",
		"typescript": "^5.2.2"
	},
	"peerDependencies": {
		"express": "^4.18.2"
