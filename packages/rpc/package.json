{
	"name": "@squaredmade/rpc",
	"version": "1.0.4",
	"publishConfig": {
		"access": "public"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"clean": "rimraf dist && rimraf node_modules",
		"prebuild": "rimraf dist",
		"prepublishOnly": "bun run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@squaredmade/context": "1.0.1",
		"@squaredmade/logger": "1.1.2",
		"@squaredmade/superjson": "1.0.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@squaredmade/builder": "^1.0.2",
		"@squaredmade/typescript-config": "^1.0.2",
		"@types/express": "^5.0.3",
		"@types/node": "^24.0.1",
		"@vitest/coverage-v8": "^3.2.3",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vitest": "^3.2.3"
	},
	"peerDependencies": {
		"express": "^5.1.0"
	}
}
