{
	"include": [
		"./**/*.ts",
		"./src/**/*.ts",
		"./src/**/*.tsx",
		"./.storybook/**/*.ts",
		"./.storybook/**/*.tsx",
		"./styles/safelist.tsx"
	],
	"compilerOptions": {
		"module": "esnext",
		"allowJs": false,
		"allowSyntheticDefaultImports": true,
		"alwaysStrict": true,
		"baseUrl": ".",
		"declaration": true,
		"emitDecoratorMetadata": false,
		"esModuleInterop": true,
		"experimentalDecorators": false,
		"forceConsistentCasingInFileNames": true,
		"importHelpers": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"lib": ["DOM", "ESNext", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"noEmit": true,
		"noFallthroughCasesInSwitch": false,
		"noImplicitAny": true,
		"noImplicitReturns": false,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"pretty": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"strictFunctionTypes": true,
		"strictNullChecks": true,
		"strictPropertyInitialization": true,
		"stripInternal": true,
		"target": "ES2022",
		"types": ["node"],
		"typeRoots": ["../../node_modules/@types"],
		"paths": {
			"@squaredmade/ui/accordion": ["./src/accordion"],
			"@squaredmade/ui/alert": ["./src/alert"],
			"@squaredmade/ui/alert-dialog": ["./src/alert-dialog"],
			"@squaredmade/ui/avatar": ["./src/avatar"],
			"@squaredmade/ui/badge": ["./src/badge"],
			"@squaredmade/ui/button": ["./src/button"],
			"@squaredmade/ui/calendar": ["./src/calendar"],
			"@squaredmade/ui/card": ["./src/card"],
			"@squaredmade/ui/checkbox": ["./src/checkbox"],
			"@squaredmade/ui/cn": ["./src/cn"],
			"@squaredmade/ui/collapsible": ["./src/collapsible"],
			"@squaredmade/ui/dialog": ["./src/dialog"],
			"@squaredmade/ui/dropdown-menu": ["./src/dropdown-menu"],
			"@squaredmade/icons": ["./src/icons"],
			"@squaredmade/ui/input": ["./src/input"],
			"@squaredmade/ui/label": ["src/label"],
			"@squaredmade/ui/popover": ["./src/popover"],
			"@squaredmade/ui/select": ["./src/select"],
			"@squaredmade/ui/separator": ["./src/separator"],
			"@squaredmade/ui/sheet": ["./src/sheet"],
			"@squaredmade/ui/skeleton": ["./src/skeleton"],
			"@squaredmade/ui/spinner": ["./src/spinner"],
			"@squaredmade/ui/switch": ["./src/switch"],
			"@squaredmade/ui/tabs": ["./src/tabs"],
			"@squaredmade/ui/textarea": ["./src/textarea"],
			"@squaredmade/ui/toast": ["./src/toast"],
			"@squaredmade/ui/tooltip": ["./src/tooltip"]
		}
	}
}
