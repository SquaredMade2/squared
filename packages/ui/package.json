    "check-types": "tsc --skipLibCheck --noEmit",
    "test": "jest",
    "test:ci": "pnpm check-types && jest --ci && pnpm cypress:ci",
    "storybook": "cross-env BROWSER=none storybook dev -p 9009",
    "cypress:ci": "start-server-and-test storybook http://localhost:9009 cypress:run",
