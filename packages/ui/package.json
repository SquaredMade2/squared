{
  "name": "@repo/ui",
  "version": "0.0.0",
  "exports": {
    "./button": "./src/button.tsx"
  },
  "scripts": {
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format:write": "biome format --write .",
    "format:check": "biome format .",
    "types:check": "tsc --skipLibCheck --noEmit",
    "test": "jest",
    "test:ci": "pnpm types:check && jest --ci && pnpm cypress:ci",
    "storybook": "cross-env BROWSER=none storybook dev -p 9009",
    "cypress:ci": "start-server-and-test storybook http://localhost:9009 cypress:run",
    "cypress:run": "cypress run",
    "cypress:dev": "cypress open",
    "dev": "pnpm storybook",
    "build-storybook": "storybook build",
    "build": "node build.mjs",
    "publish:stable": "pnpm bump:stable && rimraf dist && pnpm build && pnpm -r publish -access public",
    "publish:next": "pnpm bump:next && rimraf dist && pnpm build && pnpm -r publish -access public --tag next",
    "reset": "rimraf node_modules dist",
    "bump:stable": "pnpm version patch --no-git-tag-version",
    "bump:next": "pnpm version prerelease --preid beta --no-git-tag-version",
    "bump:check": "pnpm version check"
  },
  "dependencies": {
