    "@types/resize-observer-browser": "^0.1.11",
    "cypress": "^8.7.0",
    "cypress-real-events": "^1.13.0",
    "esbuild": "0.21.4",
    "fs-extra": "^11.2.0",
    "glob": "^10.4.2",
    "husky": "^4.3.8",
    "jest": "^28.0.0",
    "jest-axe": "^6.0.1",
    "jest-watch-typeahead": "^1.1.0",
    "lint-staged": "^10.5.4",
    "prettier": "^2.8.8",
