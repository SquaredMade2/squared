	"scripts": {
		"build": "NODE_ENV=production bun build.ts",
		"check-types": "tsc --noEmit",
		"clean": "find . -type d -name 'dist' -exec rm -rf {} +",
		"knip": "knip",
		"prebuild": "rm -rf dist",
		"release": "bun build && changeset publish"
