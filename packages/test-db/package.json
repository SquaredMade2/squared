{
  "name": "@repo/test-db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "cross-env NODE_ENV=test ts-node src/seed.ts",
    "docker:db": "docker-compose -f docker-compose.yml up -d",
    "docker:db:down": "docker-compose -f docker-compose.yml down --volumes",
    "postinstall": "pnpm run db:generate && pnpm run db:test:generate",
    "studio": "prisma studio",
    "test:studio": "dotenv -e .env.run.test -- prisma studio",
    "db:test:generate": "dotenv -e .env.run.test -- pnpm run db:generate",
    "db:test:push": "dotenv -e .env.run.test -- pnpm run db:push",
    "db:test:reset": "dotenv -e .env.run.test -- prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "dotenv-cli": "^7.4.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@repo/typescript-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.4.1",
    "bcryptjs": "^2.4.3",
    "cross-env": "^7.0.3",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.3"
  }
}