generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("TEST_POSTGRES_PRISMA_URL")
  directUrl = env("TEST_POSTGRES_URL_NON_POOLING")
}

enum Status {
  backlog
  todo
  inProgress
  inReview
  done
}

enum Priority {
  noPriority
  urgent
  high
  medium
  low
}

enum ActivityType {
  TASK_EVENT
  COMMIT
}

model Commit {
  id                String   @id @default(uuid())
  treeId            String
  distinct          Boolean?
  message           String
  timestamp         String
  url               String
  authorName        String?
  authorEmail       String?
  authorUsername    String?
  committerName     String?
  committerEmail    String?
  committerUsername String?
  added             String[]
  removed           String[]
  modified          String[]
  repoName          String?
  owner             String?
  activityId        String   @unique

  activity Activity @relation(fields: [activityId], references: [id])

  Branch Branch @relation(fields: [treeId], references: [id])
}

model Branch {
  id               String @id @default(uuid())
  name             String
  taskId           String @unique
  githubRepoInfoId String

  commits Commit[]

  task           Task            @relation(fields: [taskId], references: [id])
  GithubRepoInfo GithubRepoInfo? @relation(fields: [githubRepoInfoId], references: [id])
}

model TaskEventLog {
  id         String   @id @default(uuid())
  authorId   String
  authorName String
  createdAt  DateTime @default(now())
  taskId     String   @unique

  activities Activity[]

  Task      Task        @relation(fields: [taskId], references: [id])
  TaskEvent TaskEvent[]
}

model Activity {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now())
  commit     Commit?
  taskEvent  TaskEvent?
  eventLogId String

  type ActivityType

  taskEventLog TaskEventLog @relation(fields: [eventLogId], references: [id])
}

model TaskEvent {
  id           String   @id @default(uuid())
  type         String
  authorId     String
  authorName   String
  activityId   String   @unique
  createdAt    DateTime @default(now())
  taskId       String
  updatedValue String?

  activity     Activity     @relation(fields: [activityId], references: [id])
  taskEventLog TaskEventLog @relation(fields: [taskId], references: [id])
}

model Comment {
  id       String   @id @default(uuid())
  comment  String
  authorId String
  date     DateTime @default(now())
  taskId   String

  Task   Task @relation(fields: [taskId], references: [id])
  Author User @relation(fields: [authorId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  taskIds     String[]
  read        Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  User User @relation(fields: [userId], references: [id])
}

model Task {
  id             String    @id @default(uuid())
  authorId       String
  title          String
  description    String?
  identifier     String
  dueDate        DateTime?
  effortEstimate Int?
  teamId         String
  dateCreated    DateTime  @default(now())
  assigneeId     String?
  assigneeName   String?
  labels         String[]

  status   Status        @default(todo)
  priority Priority      @default(noPriority)
  Comments Comment[]
  Events   TaskEventLog?
  Branch   Branch?

  Author User @relation(fields: [authorId], references: [id])
  Team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Team {
  id          String  @id @default(uuid())
  name        String?
  identifier  String
  workspaceId String

  Tasks   Task[]
  Project Project[]

  Workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Users     UserTeam[]
}

model User {
  id                 String   @id @default(uuid())
  name               String
  username           String?
  email              String   @unique
  password           String
  verified           Boolean  @default(false)
  lastLogin          DateTime @default(now())
  onBoarding         Boolean  @default(true)
  defaultWorkspaceId String?
  avatarUrl          String?

  Workspaces   UserWorkspace[]
  Notification Notification[]
  Comment      Comment[]
  Task         Task[]

  DefaultWorkspace Workspace? @relation(fields: [defaultWorkspaceId], references: [id])
  Teams            UserTeam[]
}

model Label {
  id          String  @id @default(uuid())
  name        String
  description String?
  color       String
  workspaceId String

  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model SavedFilter {
  id          String @id @default(uuid())
  name        String
  filter      Json
  workspaceId String

  Workspace Workspace? @relation(fields: [workspaceId], references: [id])
}

model Workspace {
  id                   String  @id @default(uuid())
  name                 String
  url                  String  @unique
  companySize          Int?
  issuesCreated        Int     @default(0)
  universalTokenLinkId String?
  githubRepoInfoId     String?
  avatarUrl            String?

  workspaceFilters   SavedFilter[]
  Label              Label[]
  universalTokenLink UniversalTokenLink?
  teams              Team[]
  projects           Project[]
  githubRepoInfo     GithubRepoInfo?
  Users              UserWorkspace[]
  User               User[]
}

model UserWorkspace {
  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@id([userId, workspaceId])
}

model UserTeam {
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@id([userId, teamId])
}

model UniversalTokenLink {
  id          String  @id @default(uuid())
  token       String  @default("")
  isEnabled   Boolean @default(true)
  workspaceId String  @unique

  Workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model GithubRepoInfo {
  id          String   @id @default(uuid())
  repoName    String   @default("")
  owner       String   @default("")
  workspaceId String   @unique
  branches    Branch[]

  Workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model Project {
  id          String  @id @default(uuid())
  name        String
  teamId      String?
  workspaceId String?

  Team      Team?      @relation(fields: [teamId], references: [id])
  Workspace Workspace? @relation(fields: [workspaceId], references: [id])
}
