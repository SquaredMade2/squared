generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("TEST_POSTGRES_PRISMA_URL")
  directUrl = env("TEST_POSTGRES_URL_NON_POOLING")
}

enum Status {
  backlog
  todo
  inProgress
  done
  canceled
  duplicate
}

enum Priority {
  noPriority
  urgent
  high
  medium
  low
}

enum Label {
  Bug
  Feature
  Improvement
  Red
  Test
}

model Commit {
  id                String   @id
  tree_id           String?
  distinct          Boolean?
  message           String
  timestamp         String
  url               String
  authorName        String?
  authorEmail       String?
  authorUsername    String?
  committerName     String?
  committerEmail    String?
  committerUsername String?
  added             String[]
  removed           String[]
  modified          String[]
  repoName          String?
  owner             String?
}

model TaskEventLog {
  id         String   @id @default(uuid())
  authorId   String
  authorName String
  createdAt  DateTime @default(now())
  taskId     String

  taskEvents TaskEvent[] @relation("EventLogs")
}

model TaskEvent {
  id                   String   @id @default(uuid())
  type                 String
  authorId             String
  authorName           String
  taskId               String
  updatedAt            DateTime @default(now())
  originalLabels       Label[]
  updatedLabels        Label[]
  originalValue        String?
  updatedValue         String?
  originalAssigneeId   String?
  originalAssigneeName String?
  updatedAssigneeId    String?
  updatedAssigneeName  String?

  taskEventLog TaskEventLog @relation("EventLogs", fields: [taskId], references: [id])
}

model Comment {
  id       String   @id @default(uuid())
  comment  String
  authorId String
  date     DateTime @default(now())
  taskId   String

  Task   Task @relation(fields: [taskId], references: [id])
  Author User @relation(fields: [authorId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  taskIds     String[]
  read        Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  User User @relation(fields: [userId], references: [id])
}

model PageFilterModel {
  id                String  @id @default(uuid())
  filterTitle       String
  filterOption      Json
  filterDescription String?
  teamId            String
}

model Task {
  id             String    @id @default(uuid())
  authorId       String
  title          String
  description    String?
  status         Status
  identifier     String
  priority       Priority?
  labels         Label[]
  dueDate        DateTime?
  effortEstimate Int?
  teamId         String
  dateCreated    DateTime  @default(now())
  assigneeId     String?
  assigneeName   String?

  Author  User      @relation(fields: [authorId], references: [id])
  Team    Team      @relation(fields: [teamId], references: [id])
  Comment Comment[]
}

model Team {
  id          String  @id @default(uuid())
  name        String?
  identifier  String
  workspaceId String

  Users     User[]    @relation("TeamUsers")
  Tasks     Task[]
  Workspace Workspace @relation(fields: [workspaceId], references: [id])
  Project   Project[]
}

model User {
  id                 String   @id @default(uuid())
  name               String
  username           String?
  email              String   @unique
  password           String
  verified           Boolean  @default(false)
  lastLogin          DateTime @default(now())
  onBoarding         Boolean  @default(false)
  defaultWorkspaceId String?

  DefaultWorkspace Workspace?     @relation(fields: [defaultWorkspaceId], references: [id])
  Workspaces       Workspace[]    @relation("UserWorkspaces")
  Teams            Team[]         @relation("TeamUsers")
  Notification     Notification[]
  Comment          Comment[]
  Task             Task[]
}

model Workspace {
  id                   String  @id @default(uuid())
  name                 String?
  url                  String?
  companySize          Int?
  issuesCreated        Int?
  universalTokenLinkId String?
  githubRepoInfoId     String?

  universalTokenLink UniversalTokenLink? @relation(fields: [universalTokenLinkId], references: [id])
  teams              Team[]
  projects           Project[]
  githubRepoInfo     GithubRepoInfo?     @relation(fields: [githubRepoInfoId], references: [id])
  Users              User[]              @relation("UserWorkspaces")
  User               User[]
}

model UniversalTokenLink {
  id        String  @id @default(uuid())
  token     String  @default("")
  isEnabled Boolean @default(true)

  Workspace Workspace[]
}

model GithubRepoInfo {
  id       String @id @default(uuid())
  repoName String @default("")
  owner    String @default("")

  Workspace Workspace[]
}

model Project {
  id          String  @id @default(uuid())
  name        String
  teamId      String?
  workspaceId String?

  Team      Team?      @relation(fields: [teamId], references: [id])
  Workspace Workspace? @relation(fields: [workspaceId], references: [id])
}
