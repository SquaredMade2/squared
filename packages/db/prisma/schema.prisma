generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

enum Status {
  backlog
  todo
  inProgress
  inReview
  done
  canceled
  archived
}

enum Effort {
  LINEAR
  FIBONACCI
  EXPONENTIAL
}

enum Priority {
  noPriority
  urgent
  high
  medium
  low
}

enum ActivityType {
  TASK_EVENT
  COMMIT
}

enum NotificationType {
  ASSIGNED
  PARTICIPATING
  MENTIONED
  CREATED
}

enum SavedFilterType {
  TEAM
  WORKSPACE
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum RetrospectiveItemType {
  wentWell
  toImprove
  actionItems
}

model Commit {
  id         String   @id
  branchId   String
  message    String
  timestamp  DateTime
  url        String
  authorName String?
  repoName   String?
  owner      String?
  taskId     String?

  Branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Task   Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
}

model Branch {
  id               String @id @default(uuid())
  name             String
  taskId           String
  githubRepoInfoId String

  commits Commit[]

  task           Task            @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  GithubRepoInfo GithubRepoInfo? @relation(fields: [githubRepoInfoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model TaskEvent {
  id        String   @id @default(uuid())
  authorId  String
  createdAt DateTime @default(now())
  taskId    String
  message   String

  Task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Author User @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Comment {
  id       String   @id @default(uuid())
  comment  String
  authorId String
  date     DateTime @default(now())
  taskId   String

  Task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Author User @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  taskId      String
  read        Boolean  @default(false)
  saved       Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  workspaceId String
  dismissed   Boolean  @default(false)

  type NotificationType

  Task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Task {
  id             String    @id @default(uuid())
  authorId       String
  title          String
  description    String?
  identifier     String
  dueDate        DateTime?
  effortEstimate Int?
  teamId         String
  dateCreated    DateTime  @default(now())
  assigneeId     String?
  assigneeName   String?
  labels         String[]
  workspaceId    String
  updatedAt      DateTime  @default(now()) @updatedAt
  deleted        Boolean   @default(false)
  parentId       String?
  sprintId       String?
  order          Int       @default(0)

  parent   Task?       @relation("ParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children Task[]      @relation("ParentChild")
  status   Status      @default(backlog)
  priority Priority    @default(noPriority)
  Comments Comment[]
  Events   TaskEvent[]
  Commits  Commit[]
  Branch   Branch[]

  Author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Sprint       Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  Notification Notification[]

  @@unique([workspaceId, identifier])
  @@unique([teamId, identifier])
}

model Team {
  id               String   @id @default(uuid())
  name             String?
  identifier       String
  workspaceId      String
  sprintsEnabled   Boolean  @default(false)
  sprintDuration   Int      @default(2)
  cooldownDuration Int      @default(1)
  sprintStartDate  DateTime @default(now())
  tasksPerSprint   Int      @default(10)

  effort    Effort        @default(LINEAR)
  Tasks     Task[]
  Project   Project[]
  Users     UserTeam[]
  teamViews SavedFilter[]

  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Sprints   Sprint[]

  @@unique([workspaceId, identifier])
}

model User {
  id                   String   @id @default(uuid())
  name                 String
  username             String?
  email                String   @unique
  password             String?
  verified             Boolean  @default(false)
  lastLogin            DateTime @default(now())
  onBoarding           Boolean  @default(true)
  defaultWorkspaceId   String?
  avatarUrl            String?
  savedNotificationIds String[] @default([])
  subscribedTasks      String[] @default([])
  googleId             String?
  githubUsername       String?
  githubId             String?

  Workspaces   UserWorkspace[]
  Notification Notification[]
  Comment      Comment[]
  Task         Task[]
  savedFilters SavedFilter[]

  DefaultWorkspace Workspace?  @relation(fields: [defaultWorkspaceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  Teams            UserTeam[]
  TaskEvent        TaskEvent[]
}

model Label {
  id          String  @id @default(uuid())
  name        String
  description String?
  color       String
  workspaceId String

  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model SavedFilter {
  id          String  @id @default(uuid())
  name        String
  description String? @default("")
  filter      Json[]
  workspaceId String?
  teamId      String?
  authorId    String

  type SavedFilterType

  Workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Team      Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([workspaceId], name: "workspaceIdx")
  @@index([teamId], name: "teamIdx")
}

model Workspace {
  id                   String   @id @default(uuid())
  name                 String
  url                  String   @unique
  companySize          Int?
  tasksCreated         Int      @default(0)
  universalTokenLinkId String?
  avatarUrl            String?
  admins               String[]

  workspaceViews        SavedFilter[]
  Labels                Label[]
  universalTokenLink    UniversalTokenLink?
  teams                 Team[]
  projects              Project[]
  Users                 UserWorkspace[]
  User                  User[]
  Tasks                 Task[]
  WorkspaceRepositories WorkspaceRepositories[]
  Notification          Notification[]
}

model UserWorkspace {
  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, workspaceId])
}

model UserTeam {
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, teamId])
}

model UniversalTokenLink {
  id          String  @id @default(uuid())
  token       String  @default("")
  isEnabled   Boolean @default(true)
  workspaceId String  @unique

  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model GithubRepoInfo {
  id       String @id @default(uuid())
  repoName String @unique @default("")
  owner    String @default("")

  branches      Branch[]
  WorkspaceRepo WorkspaceRepositories[]
}

model WorkspaceRepositories {
  id          String @id @default(uuid())
  workspaceId String
  repoId      String

  Workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  GitHubRepoInfo GithubRepoInfo @relation(fields: [repoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workspaceId, repoId])
}

model Project {
  id          String  @id @default(uuid())
  name        String
  teamId      String?
  workspaceId String?

  Team      Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  Workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Sprint {
  id          String              @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      SprintStatus
  teamId      String
  wentWell    RetrospectiveItem[] @relation("WentWell")
  toImprove   RetrospectiveItem[] @relation("ToImprove")
  actionItems RetrospectiveItem[] @relation("ActionItems")

  Team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  Tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RetrospectiveItem {
  id      String                @id @default(uuid())
  content String
  type    RetrospectiveItemType @default(toImprove)

  wentWellSprint      Sprint? @relation("WentWell", fields: [wentWellSprintId], references: [id])
  wentWellSprintId    String?
  toImproveSprint     Sprint? @relation("ToImprove", fields: [toImproveSprintId], references: [id])
  toImproveSprintId   String?
  actionItemsSprint   Sprint? @relation("ActionItems", fields: [actionItemsSprintId], references: [id])
  actionItemsSprintId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
