generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Status {
  backlog
  todo
  inProgress
  done
  canceled
  duplicate
}

enum Priority {
  noPriority
  urgent
  high
  medium
  low
}

enum Label {
  Bug
  Feature
  Improvement
  Red
  Test
}

model Commit {
  id                String   @id
  tree_id           String?
  distinct          Boolean?
  message           String
  timestamp         String
  url               String
  authorName        String?
  authorEmail       String?
  authorUsername    String?
  committerName     String?
  committerEmail    String?
  committerUsername String?
  added             String[]
  removed           String[]
  modified          String[]
  repoName          String?
  owner             String?
}

model TaskEventLog {
  id         String      @id @default(uuid())
  authorId   String
  authorName String
  createdAt  DateTime    @default(now())
  taskId     String
  eventsLog  TaskEvent[] @relation("EventLogs")
}

model TaskEvent {
  id                   String       @id @default(uuid())
  type                 String
  authorId             String
  authorName           String
  taskId               String
  updatedAt            DateTime     @default(now())
  originalLabels       Label[]
  updatedLabels        Label[]
  originalValue        String?
  updatedValue         String?
  originalAssigneeId   String?
  originalAssigneeName String?
  updatedAssigneeId    String?
  updatedAssigneeName  String?
  log                  TaskEventLog @relation("EventLogs", fields: [taskId], references: [id])
}

model Comment {
  id       String   @id @default(uuid())
  comment  String
  authorId String
  date     DateTime @default(now())
  taskId   String
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  taskIds     String[]
  read        Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PageFilterModel {
  id                String  @id @default(uuid())
  filterTitle       String
  filterOption      Json
  filterDescription String?
  teamId            String
}

model Task {
  id             String    @id @default(uuid())
  authorId       String
  title          String
  description    String?
  status         Status
  identifier     String
  priority       Priority?
  labels         Label[]
  dueDate        DateTime?
  effortEstimate Int?
  teamId         String
  dateCreated    DateTime  @default(now())
  assigneeId     String?
  assigneeName   String?

  Team Team @relation(fields: [teamId], references: [id])
}

model Team {
  id          String    @id @default(uuid())
  name        String?
  identifier  String
  workspaceId String
  users       User[]    @relation("TeamUsers")
  tasks       Task[]
  Workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model User {
  id                 String      @id @default(uuid())
  name               String
  username           String?
  email              String      @unique
  password           String
  verified           Boolean     @default(false)
  lastLogin          DateTime    @default(now())
  onBoarding         Boolean     @default(false)
  defaultWorkspaceId String?
  workspaces         Workspace[] @relation("UserWorkspaces")
  teams              Team[]      @relation("TeamUsers")
}

model Workspace {
  id                   String              @id @default(uuid())
  name                 String?
  url                  String?
  companySize          Int?
  universalTokenLink   UniversalTokenLink? @relation(fields: [universalTokenLinkId], references: [id])
  teams                Team[]
  users                User[]              @relation("UserWorkspaces")
  projects             Project[]
  issuesCreated        Int?
  githubRepoInfo       GithubRepoInfo?     @relation(fields: [githubRepoInfoId], references: [id])
  universalTokenLinkId String?
  githubRepoInfoId     String?
}

model UniversalTokenLink {
  id        String      @id @default(uuid())
  token     String      @default("")
  isEnabled Boolean     @default(true)
  Workspace Workspace[]
}

model GithubRepoInfo {
  id        String      @id @default(uuid())
  repoName  String      @default("")
  owner     String      @default("")
  Workspace Workspace[]
}

model Project {
  id          String     @id @default(uuid())
  name        String
  teamId      String?
  Workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  workspaceId String?
}
