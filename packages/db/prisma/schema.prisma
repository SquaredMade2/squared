generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

enum Status {
  backlog
  todo
  inProgress
  inReview
  done
  canceled
  archived
}

enum Priority {
  noPriority
  urgent
  high
  medium
  low
}

enum ActivityType {
  TASK_EVENT
  COMMIT
}

enum NotificationType {
  ASSIGNED
  PARTICIPATING
  MENTIONED
  CREATED
}

enum SavedFilterType {
  TEAM
  WORKSPACE
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Commit {
  id                String   @id @default(uuid())
  treeId            String
  distinct          Boolean?
  message           String
  timestamp         String
  url               String
  authorName        String?
  authorEmail       String?
  authorUsername    String?
  committerName     String?
  committerEmail    String?
  committerUsername String?
  added             String[]
  removed           String[]
  modified          String[]
  repoName          String?
  owner             String?
  activityId        String   @unique

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  Branch Branch @relation(fields: [treeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Branch {
  id               String @id @default(uuid())
  name             String
  taskId           String
  githubRepoInfoId String

  commits Commit[]

  task           Task            @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  GithubRepoInfo GithubRepoInfo? @relation(fields: [githubRepoInfoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model TaskEventLog {
  id         String   @id @default(uuid())
  authorId   String
  authorName String
  createdAt  DateTime @default(now())
  taskId     String   @unique

  activities Activity[]

  Task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  TaskEvent TaskEvent[]
}

model Activity {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now())
  commit     Commit?
  taskEvent  TaskEvent?
  eventLogId String

  type ActivityType

  taskEventLog TaskEventLog @relation(fields: [eventLogId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model TaskEvent {
  id                   String   @id @default(uuid())
  type                 String
  authorId             String
  authorName           String
  activityId           String   @unique
  createdAt            DateTime @default(now())
  taskId               String
  originalValue        String?
  updatedValue         String?
  originalAssigneeId   String?
  originalAssigneeName String?
  updatedAssigneeId    String?
  updatedAssigneeName  String?
  gitUpdated           String?
  originalLabels       String[]
  updatedLabels        String[]

  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  taskEventLog TaskEventLog @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Comment {
  id       String   @id @default(uuid())
  comment  String
  authorId String
  date     DateTime @default(now())
  taskId   String

  Task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Author User @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  taskId      String
  read        Boolean  @default(false)
  saved       Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  workspaceId String
  dismissed   Boolean  @default(false)

  type NotificationType

  Task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Task {
  id             String    @id @default(uuid())
  authorId       String
  title          String
  description    String?
  identifier     String
  dueDate        DateTime?
  effortEstimate Int?
  teamId         String
  dateCreated    DateTime  @default(now())
  assigneeId     String?
  assigneeName   String?
  labels         String[]
  workspaceId    String
  updatedAt      DateTime  @default(now()) @updatedAt
  deleted        Boolean   @default(false)
  parentId       String?
  sprintId       String?

  parent   Task?         @relation("ParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children Task[]        @relation("ParentChild")
  status   Status        @default(backlog)
  priority Priority      @default(noPriority)
  Comments Comment[]
  Events   TaskEventLog?
  Branch   Branch[]

  Author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Sprint       Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  Notification Notification[]

  @@unique([workspaceId, identifier])
  @@unique([teamId, identifier])
}

model Team {
  id               String   @id @default(uuid())
  name             String?
  identifier       String
  workspaceId      String
  sprintsEnabled   Boolean  @default(false)
  sprintDuration   Int      @default(2)
  cooldownDuration Int      @default(1)
  upcomingSprints  Int      @default(3)
  activeRequired   Boolean  @default(true)
  sprintStartDate  DateTime @default(now())
  tasksPerSprint   Int      @default(10)

  Tasks     Task[]
  Project   Project[]
  Users     UserTeam[]
  teamViews SavedFilter[]

  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Sprints   Sprint[]

  @@unique([workspaceId, identifier])
}

model User {
  id                   String   @id @default(uuid())
  name                 String
  username             String?
  email                String   @unique
  password             String?
  verified             Boolean  @default(false)
  lastLogin            DateTime @default(now())
  onBoarding           Boolean  @default(true)
  defaultWorkspaceId   String?
  avatarUrl            String?
  lastTaskViewed       String?
  savedNotificationIds String[] @default([])
  subscribedTasks      String[] @default([])
  googleId             String?
  githubUsername       String?
  githubId             String?

  Workspaces   UserWorkspace[]
  Notification Notification[]
  Comment      Comment[]
  Task         Task[]

  DefaultWorkspace Workspace? @relation(fields: [defaultWorkspaceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  Teams            UserTeam[]
}

model Label {
  id          String  @id @default(uuid())
  name        String
  description String?
  color       String
  workspaceId String

  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model SavedFilter {
  id          String  @id @default(uuid())
  name        String
  description String? @default("")
  filter      Json[]
  workspaceId String?
  teamId      String?

  type SavedFilterType

  Workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Team      Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([workspaceId], name: "workspaceIdx")
  @@index([teamId], name: "teamIdx")
}

model Workspace {
  id                   String   @id @default(uuid())
  name                 String
  url                  String   @unique
  companySize          Int?
  tasksCreated         Int      @default(0)
  universalTokenLinkId String?
  avatarUrl            String?
  admins               String[]

  workspaceViews        SavedFilter[]
  Labels                Label[]
  universalTokenLink    UniversalTokenLink?
  teams                 Team[]
  projects              Project[]
  Users                 UserWorkspace[]
  User                  User[]
  Tasks                 Task[]
  notifications         Notification[]
  WorkspaceRepositories WorkspaceRepositories[] 
}

model UserWorkspace {
  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, workspaceId])
}

model UserTeam {
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, teamId])
}

model UniversalTokenLink {
  id          String  @id @default(uuid())
  token       String  @default("")
  isEnabled   Boolean @default(true)
  workspaceId String  @unique

  Workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model GithubRepoInfo {
  id          String   @id @default(uuid())
  repoName    String   @unique @default("")
  owner       String   @default("")

  branches    Branch[]  
  WorkspaceRepo WorkspaceRepositories[]
}

model WorkspaceRepositories {
  id          String            @id @default(uuid())
  workspaceId String
  repoId      String

  Workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  GitHubRepoInfo GithubRepoInfo @relation(fields: [repoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workspaceId, repoId])
}

model Project {
  id          String  @id @default(uuid())
  name        String
  teamId      String?
  workspaceId String?

  Team      Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  Workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Sprint {
  id          String       @id @default(uuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  status      SprintStatus
  teamId      String
  wentWell    String[]
  toImprove   String[]
  actionItems String[]

  Team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  Tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
