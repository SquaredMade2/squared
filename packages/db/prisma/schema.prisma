generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Status {
  backlog
  todo
  inProgress
  done
  canceled
  duplicate
}

enum Priority {
  noPriority
  urgent
  high
  medium
  low
}

enum Label {
  Bug
  Feature
  Improvement
  Red
  Test
}

model Commit {
  id                String   @id @default(uuid())
  treeId            String
  distinct          Boolean?
  message           String
  timestamp         String
  url               String
  authorName        String?
  authorEmail       String?
  authorUsername    String?
  committerName     String?
  committerEmail    String?
  committerUsername String?
  added             String[]
  removed           String[]
  modified          String[]
  repoName          String?
  owner             String?

  Branch Branch @relation(fields: [treeId], references: [id])
}

model Branch {
  id               String @id @default(uuid())
  name             String
  taskId           String @unique
  githubRepoInfoId String

  commits Commit[]

  task           Task            @relation(fields: [taskId], references: [id])
  GithubRepoInfo GithubRepoInfo? @relation(fields: [githubRepoInfoId], references: [id])
}

model TaskEventLog {
  id         String   @id @default(uuid())
  authorId   String
  authorName String
  createdAt  DateTime @default(now())
  taskId     String

  taskEvents TaskEvent[] @relation("EventLogs")
}

model TaskEvent {
  id                   String   @id @default(uuid())
  type                 String
  authorId             String
  authorName           String
  taskId               String
  updatedAt            DateTime @default(now())
  originalValue        String?
  updatedValue         String?
  originalAssigneeId   String?
  originalAssigneeName String?
  updatedAssigneeId    String?
  updatedAssigneeName  String?

  originalLabels Label[]
  updatedLabels  Label[]

  taskEventLog TaskEventLog @relation("EventLogs", fields: [taskId], references: [id])
}

model Comment {
  id       String   @id @default(uuid())
  comment  String
  authorId String
  date     DateTime @default(now())
  taskId   String

  Task   Task @relation(fields: [taskId], references: [id])
  Author User @relation(fields: [authorId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  taskIds     String[]
  read        Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  User User @relation(fields: [userId], references: [id])
}

model PageFilterModel {
  id                String  @id @default(uuid())
  filterTitle       String
  filterOption      Json
  filterDescription String?
  teamId            String
}

model Task {
  id             String    @id @default(uuid())
  authorId       String
  title          String
  description    String?
  identifier     String
  dueDate        DateTime?
  effortEstimate Int?
  teamId         String
  dateCreated    DateTime  @default(now())
  assigneeId     String?
  assigneeName   String?

  status   Status
  priority Priority?
  labels   Label[]
  Branch   Branch?
  Comment  Comment[]

  Author User @relation(fields: [authorId], references: [id])
  Team   Team @relation(fields: [teamId], references: [id])
}

model Team {
  id          String  @id @default(uuid())
  name        String?
  identifier  String
  workspaceId String

  Tasks   Task[]
  Project Project[]

  Users     User[]    @relation("TeamUsers")
  Workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model User {
  id                 String   @id @default(uuid())
  name               String
  username           String?
  email              String   @unique
  password           String
  verified           Boolean  @default(false)
  lastLogin          DateTime @default(now())
  onBoarding         Boolean  @default(false)
  defaultWorkspaceId String?

  Workspaces   UserWorkspace[]
  Notification Notification[]
  Comment      Comment[]
  Task         Task[]
  SavedFilters SavedFilter[]

  DefaultWorkspace Workspace? @relation(fields: [defaultWorkspaceId], references: [id])
  Teams            Team[]     @relation("TeamUsers")
}

model SavedFilter {
  id             String    @id @default(uuid())
  userId         String
  title          String
  identifier     String
  status         Status?
  priority       Priority?
  labels         Label[]
  dueDate        DateTime?
  effortEstimate Int?

  User User @relation(fields: [userId], references: [id])
}

model Workspace {
  id                   String  @id @default(uuid())
  name                 String?
  url                  String?
  companySize          Int?
  issuesCreated        Int?
  universalTokenLinkId String?
  githubRepoInfoId     String?

  universalTokenLink UniversalTokenLink?
  teams              Team[]
  projects           Project[]
  githubRepoInfo     GithubRepoInfo?
  Users              UserWorkspace[]
  User               User[]
}

model UserWorkspace {
  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@id([userId, workspaceId])
}

model UniversalTokenLink {
  id          String  @id @default(uuid())
  token       String  @default("")
  isEnabled   Boolean @default(true)
  workspaceId String  @unique

  Workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model GithubRepoInfo {
  id          String   @id @default(uuid())
  repoName    String   @default("")
  owner       String   @default("")
  workspaceId String   @unique
  branches    Branch[]

  Workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model Project {
  id          String  @id @default(uuid())
  name        String
  teamId      String?
  workspaceId String?

  Team      Team?      @relation(fields: [teamId], references: [id])
  Workspace Workspace? @relation(fields: [workspaceId], references: [id])
}
