generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Commit {
  id         String   @id
  message    String
  url        String
  authorName String?
  repoName   String?
  owner      String?
  branchId   String
  taskId     String?
  timestamp  DateTime
  Branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Task       Task?    @relation(fields: [taskId], references: [id])
}

model Branch {
  id               String         @id @default(uuid())
  name             String
  taskId           String
  githubRepoInfoId String
  GithubRepoInfo   GithubRepoInfo @relation(fields: [githubRepoInfoId], references: [id], onDelete: Cascade)
  task             Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commits          Commit[]
}

model TaskEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  taskId    String
  message   String
  authorId  String
  Author    User     @relation(fields: [authorId], references: [externalId], onDelete: Cascade)
  Task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Comment {
  id       String   @id @default(uuid())
  comment  String
  date     DateTime @default(now())
  taskId   String
  authorId String
  Author   User     @relation(fields: [authorId], references: [externalId], onDelete: Cascade)
  Task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String           @id @default(uuid())
  read        Boolean          @default(false)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  dismissed   Boolean          @default(false)
  saved       Boolean          @default(false)
  taskId      String
  type        NotificationType
  workspaceId String
  userId      String
  Task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User        User             @relation(fields: [userId], references: [externalId], onDelete: Cascade)
  Workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Task {
  id                  String         @id @default(uuid())
  title               String
  description         String?
  identifier          String
  dueDate             DateTime?
  effortEstimate      Int?
  teamId              String
  dateCreated         DateTime       @default(now())
  labels              String[]
  status              Status         @default(backlog)
  priority            Priority       @default(noPriority)
  workspaceId         String
  deleted             Boolean        @default(false)
  updatedAt           DateTime       @default(now()) @updatedAt
  parentId            String?
  sprintId            String?
  order               Int            @default(0)
  authorId            String
  assigneeId          String?
  Branch              Branch[]
  Comments            Comment[]
  Commits             Commit[]
  Notification        Notification[]
  Assignee            User?          @relation("AssignedTasks", fields: [assigneeId], references: [externalId])
  Author              User           @relation("AuthoredTasks", fields: [authorId], references: [externalId], onDelete: Cascade)
  parent              Task?          @relation("ParentChild", fields: [parentId], references: [id])
  children            Task[]         @relation("ParentChild")
  Sprint              Sprint?        @relation(fields: [sprintId], references: [id])
  Team                Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  Workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Events              TaskEvent[]
  lastViewedBy        User[]         @relation("UserLastViewedTask")
  Task_BlockedTasks_A Task[]         @relation("BlockedTasks")
  Task_BlockedTasks_B Task[]         @relation("BlockedTasks")

  @@unique([workspaceId, identifier])
  @@unique([teamId, identifier])
}

model Team {
  id               String        @id @default(uuid())
  name             String?
  identifier       String
  workspaceId      String
  cooldownDuration Int           @default(1)
  sprintDuration   Int           @default(2)
  sprintStartDate  DateTime      @default(now())
  sprintsEnabled   Boolean       @default(false)
  tasksPerSprint   Int           @default(10)
  effort           Effort        @default(LINEAR)
  Project          Project[]
  teamViews        SavedFilter[]
  Sprints          Sprint[]
  Tasks            Task[]
  Workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Users            UserTeam[]

  @@unique([workspaceId, identifier])
}

model User {
  id                   String              @id @default(uuid())
  name                 String
  username             String?
  email                String              @unique
  lastLogin            DateTime            @default(now())
  onBoarding           Boolean             @default(true)
  defaultWorkspaceId   String?
  avatarUrl            String?
  savedNotificationIds String[]            @default([])
  subscribedTasks      String[]            @default([])
  githubUsername       String?
  createdAt            DateTime            @default(now())
  lastViewedTaskId     String?
  externalId           String              @unique
  Comment              Comment[]
  Notification         Notification[]
  AuthoredRetroItems   RetrospectiveItem[]
  savedFilters         SavedFilter[]
  AssignedTasks        Task[]              @relation("AssignedTasks")
  AuthoredTasks        Task[]              @relation("AuthoredTasks")
  TaskEvent            TaskEvent[]
  DefaultWorkspace     Workspace?          @relation(fields: [defaultWorkspaceId], references: [id])
  lastViewedTask       Task?               @relation("UserLastViewedTask", fields: [lastViewedTaskId], references: [id])
  Teams                UserTeam[]
  Workspaces           UserWorkspace[]
}

model Label {
  id          String    @id @default(uuid())
  name        String
  description String?
  color       String
  workspaceId String
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model SavedFilter {
  id          String          @id @default(uuid())
  name        String
  workspaceId String?
  description String?         @default("")
  teamId      String?
  type        SavedFilterType
  filter      Json[]
  sprintId    String?
  authorId    String
  Author      User            @relation(fields: [authorId], references: [externalId], onDelete: Cascade)
  Team        Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  Workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId], map: "workspaceIdx")
  @@index([teamId], map: "teamIdx")
}

model Workspace {
  id                    String                  @id @default(uuid())
  name                  String
  url                   String                  @unique
  companySize           Int?
  universalTokenLinkId  String?
  avatarUrl             String?
  tasksCreated          Int                     @default(0)
  admins                String[]
  defaultView           String?
  Labels                Label[]
  Notification          Notification[]
  projects              Project[]
  workspaceViews        SavedFilter[]
  Tasks                 Task[]
  teams                 Team[]
  universalTokenLink    UniversalTokenLink?
  User                  User[]
  Users                 UserWorkspace[]
  WorkspaceRepositories WorkspaceRepositories[]
}

model UserWorkspace {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(member)
  user        User          @relation(fields: [userId], references: [externalId], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

model UserTeam {
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [externalId], onDelete: Cascade)

  @@id([userId, teamId])
}

model UniversalTokenLink {
  id          String    @id @default(uuid())
  token       String    @default("")
  isEnabled   Boolean   @default(true)
  workspaceId String    @unique
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model GithubRepoInfo {
  id            String                  @id @default(uuid())
  repoName      String                  @unique @default("")
  owner         String                  @default("")
  branches      Branch[]
  WorkspaceRepo WorkspaceRepositories[]
}

model WorkspaceRepositories {
  id             String         @id @default(uuid())
  workspaceId    String
  repoId         String
  GitHubRepoInfo GithubRepoInfo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  Workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, repoId])
}

model Project {
  id          String     @id @default(uuid())
  name        String
  teamId      String?
  workspaceId String?
  Team        Team?      @relation(fields: [teamId], references: [id])
  Workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Sprint {
  id          String              @id @default(uuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  status      SprintStatus
  teamId      String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  description String?
  actionItems RetrospectiveItem[] @relation("ActionItems")
  toImprove   RetrospectiveItem[] @relation("ToImprove")
  wentWell    RetrospectiveItem[] @relation("WentWell")
  Team        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  Tasks       Task[]
}

model RetrospectiveItem {
  id                  String                @id @default(uuid())
  content             String
  wentWellSprintId    String?
  toImproveSprintId   String?
  actionItemsSprintId String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  type                RetrospectiveItemType @default(toImprove)
  likes               String[]              @default([])
  authorId            String
  actionItemsSprint   Sprint?               @relation("ActionItems", fields: [actionItemsSprintId], references: [id])
  Author              User                  @relation(fields: [authorId], references: [externalId], onDelete: Cascade)
  toImproveSprint     Sprint?               @relation("ToImprove", fields: [toImproveSprintId], references: [id])
  wentWellSprint      Sprint?               @relation("WentWell", fields: [wentWellSprintId], references: [id])
}

enum Status {
  backlog
  todo
  inProgress
  inReview
  done
  canceled
  archived
}

enum Effort {
  LINEAR
  FIBONACCI
  EXPONENTIAL
}

enum Priority {
  noPriority
  urgent
  high
  medium
  low
}

enum ActivityType {
  TASK_EVENT
  COMMIT
}

enum NotificationType {
  ASSIGNED
  PARTICIPATING
  MENTIONED
  CREATED
}

enum SavedFilterType {
  TEAM
  WORKSPACE
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum RetrospectiveItemType {
  wentWell
  toImprove
  actionItems
}

enum WorkspaceRole {
  owner
  admin
  member
}
