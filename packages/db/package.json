{
	"name": "@squaredmade/db",
	"version": "1.2.0",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "node build.mjs",
		"db:backup:staging": "dotenv -e .env -- sh -c './src/backup/index.sh $STAGING_READONLY_STRING squared-staging-backup us-east-1'",
		"db:backup:prod": "dotenv -e .env -- sh -c './src/backup/index.sh $PRODUCTION_READONLY_STRING squared-prod-backup us-east-1'",
		"db:gen": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.0.1",
		"drizzle-orm": "^0.44.2",
		"ws": "^8.18.2"
	},
	"devDependencies": {
		"@squaredmade/builder": "^1.0.2",
		"@squaredmade/typescript-config": "^1.0.2",
		"@types/node": "^24.0.1",
		"@types/ws": "^8.18.1",
		"dotenv": "^16.5.0",
		"drizzle-kit": "^0.31.1",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3"
	}
}
