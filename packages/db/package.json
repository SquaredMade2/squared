{
	"name": "@squaredmade/db",
	"version": "1.0.0",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"db:backup:staging": "dotenv -e .env -- sh -c './src/backup/index.sh $STAGING_READONLY_STRING squared-staging-backup us-east-1'",
		"db:backup:prod": "dotenv -e .env -- sh -c './src/backup/index.sh $PRODUCTION_READONLY_STRING squared-prod-backup us-east-1'",
		"db:gen": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.0.0",
		"drizzle-orm": "^0.41.0",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@squaredmade/builder": "^1.0.1",
		"@squaredmade/typescript-config": "^1.0.0",
		"@types/node": "^22.10.10",
		"@types/ws": "^8.5.13",
		"dotenv": "^16.4.1",
		"drizzle-kit": "^0.30.1",
		"tslib": "^2.7.0"
	}
}
