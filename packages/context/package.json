{
	"name": "@squaredmade/context",
	"version": "0.0.0",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "squared-build src/index.ts/index.ts",
		"check-types": "tsc --noEmit",
		"clean": "rimraf dist && rimraf node_modules",
		"prebuild": "rimraf ./dist",
		"prepare": "pnpm run build",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@squaredmade/builder": "workspace:*",
		"@squaredmade/typescript-config": "workspace:*",
		"@types/node": "^22.8.1",
		"typescript": "^5.8.2",
		"vitest": "^0.34.6"
	}
}
