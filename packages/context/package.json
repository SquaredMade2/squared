{
	"name": "@squared/context",
	"version": "0.0.0",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"postinstall": "pnpm run build",
		"prebuild": "rimraf ./dist",
		"build": "squared-build src/index.ts/index.ts"
	},
	"devDependencies": {
		"@squared/typescript-config": "workspace:*",
		"@squared/builder": "workspace:*",
		"@types/node": "^22.8.1"
	}
}