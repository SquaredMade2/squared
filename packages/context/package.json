{
	"name": "@squaredmade/context",
	"version": "1.0.1",
	"publishConfig": {
		"access": "public"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": ["dist", "README.md", "CHANGELOG.md"],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "bun ./build.ts",
		"check-types": "tsc --noEmit",
		"clean": "rimraf dist && rimraf node_modules",
		"prebuild": "rimraf ./dist",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@squaredmade/builder": "^1.0.2",
		"@squaredmade/typescript-config": "^1.0.0",
		"@types/node": "^22.8.1",
		"typescript": "^5.8.2",
		"vitest": "^3.0.0"
	}
}
