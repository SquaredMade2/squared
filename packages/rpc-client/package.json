{
	"name": "@squared/rpc-client",
	"version": "0.0.0",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"clean": "rimraf dist && rimraf node_modules",
		"prebuild": "rimraf dist",
		"prepare": "pnpm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@squared/context": "workspace:*",
		"@squared/superjson": "workspace:*"
	},
	"devDependencies": {
		"@squared/builder": "workspace:*",
		"@squared/typescript-config": "workspace:*",
		"@types/node": "^22.10.10",
		"@vitest/coverage-v8": "^3.0.7",
		"typescript": "^5.2.2",
		"vitest": "^0.34.6"
	}
}
