{
	"name": "@squaredmade/fonts",
	"version": "1.0.7",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": "./dist/styles.css",
			"require": "./dist/styles.css"
		}
	},
	"main": "dist/styles.css",
	"files": ["dist", "README.md", "CHANGELOG.md"],
	"scripts": {
		"build": "node build.mjs",
		"clean": "rimraf dist && rimraf node_modules",
		"prebuild": "rimraf dist"
	},
	"keywords": ["font", "noirden-sans", "tailwindcss"],
	"author": "squared",
	"license": "MIT",
	"peerDependencies": {
		"tailwindcss": "^3.0.0 || ^4.0.0"
	},
	"devDependencies": {
		"@squaredmade/builder": "1.0.2",
		"@squaredmade/typescript-config": "^1.0.2",
		"@types/node": "^24.0.1",
		"tailwindcss": "^4.1.10",
		"typescript": "^5.8.3"
	}
}
