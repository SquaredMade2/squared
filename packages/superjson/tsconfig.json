{
	"extends": "@squared/typescript-config/base.json",
	"compilerOptions": {
		"target": "ES2020",
		"module": "node16",
		"moduleResolution": "node16",
		"outDir": "./dist",
		"rootDir": ".",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"importHelpers": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"types": ["node", "jest"]
	},
	"include": ["src/**/*.ts", "build.mjs"],
	"exclude": ["node_modules", "dist"]
}
