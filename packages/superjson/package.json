{
	"name": "@squaredmade/superjson",
	"version": "1.0.0",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"check-types": "tsc --noEmit",
		"clean": "rimraf dist && rimraf node_modules",
		"prepare": "pnpm run build",
		"test": "vitest run"
	},
	"devDependencies": {
		"@squaredmade/builder": "^1.0.0",
		"@squaredmade/typescript-config": "^1.0.0",
		"@types/debug": "^4.1.12",
		"@types/node": "^22.0.0",
		"decimal.js": "^10.5.0",
		"typescript": "^5.7.3",
		"vitest": "^0.34.6"
	}
}
