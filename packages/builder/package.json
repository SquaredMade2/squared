{
	"name": "@squaredmade/builder",
	"version": "1.0.2",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"squared-build": "./dist/cli.js"
	},
	".": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md", "CHANGELOG.md"],
	"scripts": {
		"build": "bun ./build.ts",
		"clean": "rimraf dist && rimraf node_modules",
		"prebuild": "rimraf ./dist"
	},
	"devDependencies": {
		"@squaredmade/typescript-config": "^1.0.0",
		"@types/node": "^22.10.10",
		"rimraf": "^6.0.1",
		"typescript": "^5.8.2"
	},
	"dependencies": {
		"esbuild": "^0.25.0",
		"tslib": "^2.7.0",
		"tsup": "^8.0.2"
	}
}
