{
	"name": "@squared/builder",
	"version": "0.0.0",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"squared-build": "./dist/cli.js"
	},
	".": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "ts-node ./build.ts",
		"clean": "rimraf dist && rimraf node_modules",
		"prepare": "pnpm run build",
		"prebuild": "rimraf ./dist"
	},
	"devDependencies": {
		"@squared/logger": "workspace:*",
		"@squared/typescript-config": "workspace:*",
		"@types/node": "^22.10.10",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.2"
	},
	"dependencies": {
		"esbuild": "^0.24.0",
		"tslib": "^2.7.0",
		"tsup": "^8.0.2"
	}
}
